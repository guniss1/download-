        )
        return
    db.execute(
        "UPDATE chats SET top_n=?, symbols='' WHERE chat_id=?",
        (n, cid),
    )
    db.commit()
    await update.effective_message.reply_text(
        f"Автоматический режим включён: топ-{n} USDT perpetual Binance Futures "
        "по 24-часовому обороту. Ручной список монет сброшен."
    )


async def cmd_tokens(update: Update, context: ContextTypes.DEFAULT_TYPE):
    cid = update.effective_chat.id
    get_chat(cid)
    args = [x.upper().replace("/", "").replace("-", "") for x in context.args]
    if not args or args == ["AUTO"]:
        db.execute("UPDATE chats SET symbols='' WHERE chat_id=?", (cid,))
        db.commit()
        n = get_chat(cid)["top_n"]
        await update.effective_message.reply_text(
            f"Автоматический режим: топ-{n} по 24-часовому обороту."
        )
        return
    if len(args) > MAX_SYMBOLS_ALLOWED:
        await update.effective_message.reply_text(
            f"Можно указать не более {MAX_SYMBOLS_ALLOWED} монет."
        )
        return
    symbols = [x if x.endswith("USDT") else x + "USDT" for x in args]
    try:
        valid = set(await BN.tradable_usdt_perpetuals())
    except Exception as exc:
        await update.effective_message.reply_text(f"Не удалось проверить Binance: {exc}")
        return
    good = list(dict.fromkeys(x for x in symbols if x in valid))
    bad = [x for x in symbols if x not in valid]
    if good:
        db.execute("UPDATE chats SET symbols=? WHERE chat_id=?", (" ".join(good), cid))
        db.commit()
    await update.effective_message.reply_text(
        ("Ручной список: " + ", ".join(good) + ". " if good else "") +
        ("Не найдены активные USDT perpetual: " + ", ".join(bad) if bad else "")
    )


