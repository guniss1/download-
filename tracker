def trunc1(x):
    return math.floor(x * 10 + 1e-9) / 10


def fmt_vol(v):
    if v >= 1e6:
        return f"{v / 1e6:.1f}M"

    return f"{v / 1e3:.0f}K"


def fmt_k(x):
    if x >= 1e6:
        return f"{x / 1e6:.2f}M"

    if x >= 1e3:
        return f"{x / 1e3:.2f}K"

    return f"{x:.2f}"


def fmt_price(p):
    s = f"{p:.10f}".rstrip("0").rstrip(".")

    return s or "0"


def short_price(p):
    if p <= 0:
        return "0"

    decimals = max(
        2,
        -math.floor(math.log10(p)) + 1,
    )

    return f"{p:.{decimals}f}"


def qty_str(q):
    if q >= 100:
        return f"{q:,.0f}".replace(",", " ")

    return f"{q:.4g}"


def pair_url(ex_id, symbol):
    base, quote = symbol.split("/")

    return PAIR_URLS[ex_id].format(
        base=base,
        quote=quote,
        base_l=base.lower(),
        quote_l=quote.lower(),
    )


def ex_link(ex_id, symbol):
    return (
        f'<a href="{pair_url(ex_id, symbol)}">'
        f'{EX_NAMES.get(ex_id, ex_id)}</a>'
    )


def price_range(first, second):
    a = fmt_price(first)
    b = fmt_price(second)

    return a if a == b else f"[{a}:{b}]"


def status_emoji(status):
    return {
        True: "🟢",
        False: "🔴",
        "partial": "🟡",
    }.get(status, "⚪")


def fmt_anomaly(a):
    orders = a["orders"]

    base = a["symbol"].split("/")[0]

    margins = [
        o["margin"]
        for o in orders
    ]

    lo = trunc1(min(margins))
    hi = trunc1(max(margins))

    header = (
        f"<b>{a['symbol']} "
        f"[+{lo:.1f}%:+{hi:.1f}%]</b> "
        f"{status_emoji(a['transfer'])}"
    )

    body = [
        f" • <b>Выгодных ордеров:</b> {len(orders)}"
    ]

    for n, o in enumerate(
        orders[:MAX_ORDER_LINES],
        1,
    ):
        amount = o["qty"] * o["price"]

        body.append(
            f"{n})+{trunc1(o['margin']):.1f}%: "
            f"{fmt_price(o['price'])}: "
            f"[${short_price(o['price'])}:${fmt_k(amount)}]: "
            f"{qty_str(o['qty'])} {base}"
        )

    if len(orders) > MAX_ORDER_LINES:
        body.append(
            f"…и ещё {len(orders) - MAX_ORDER_LINES}"
        )

    body.append(
        f" • <b>Купля:</b> "
        f"{ex_link(a['buy_ex'], a['symbol'])} "
        f"{price_range(a['buy_lo'], a['buy_hi'])} "
        f"(24vol ${fmt_vol(a['vol_buy'])})"
    )

    body.append(
        f" • <b>Продажа:</b> "
        f"{ex_link(a['sell_ex'], a['symbol'])} "
        f"{price_range(a['sell_hi'], a['sell_lo'])} "
        f"(24vol ${fmt_vol(a['vol_sell'])})"
    )

    body.append(
        f" • <b>Доступ к выводу:</b> "
        f"{status_emoji(a['transfer'])}"
    )

    if a["transfer"] == "partial":
        body.append(
            " • <i>Перевод не подтверждён: "
            "проверьте сеть и контракт вручную.</i>"
        )

    return (
        header
        + "\n<blockquote>"
        + "\n".join(body)
        + "</blockquote>"
    )


def chunk_blocks(items):
    """
    Группирует сообщения, чтобы не превышать лимит Telegram.
    """

    chunks = []
    cur = []
    size = 0

    for key, text in items:
        if (
            cur
            and size + len(text) + 2 > MAX_MESSAGE_CHARS
        ):
            chunks.append(cur)
            cur = []
            size = 0

        cur.append((key, text))
        size += len(text) + 2

    if cur:
        chunks.append(cur)

    return chunks


