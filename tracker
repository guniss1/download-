def collect(rows, stats):
    """rows: (symbol, bid, ask, timestamp_ms, quote_volume). Считает причины отсева в stats."""
    now_ms = time.time() * 1000
    out = {}
    for sym, bid, ask, ts, vol in rows:
        stats["total"] += 1
        if not sym.endswith("/" + QUOTE) or ":" in sym:
            stats["не_спот_usdt"] += 1
            continue
        if not bid or not ask or bid <= 0 or ask <= 0:
            stats["нет_bid_ask"] += 1
            continue
        if ts and now_ms - ts > 120_000:  # устаревшая котировка
            stats["устарела"] += 1
            continue
        if (vol or 0) < MIN_VOLUME_USDT:
            stats["малый_объём"] += 1
            continue
        out[sym] = (bid, ask, vol)
    return out


def _num(x):
    try:
        return float(x)
    except (TypeError, ValueError):
        return 0.0


async def weex_raw(ex, stats):
    """Запасной путь для WEEX: напрямую публичный эндпоинт ticker/24hr
    (в нём есть bidPrice, askPrice и quoteVolume)."""
    resp = await ex.publicGetApiV3MarketTicker24hr()
    items = resp.get("data", resp) if isinstance(resp, dict) else resp
    rows = []
    for t in items or []:
        raw = str(t.get("symbol", ""))
        if not raw.endswith(QUOTE):
            continue
        sym = f"{raw[:-len(QUOTE)]}/{QUOTE}"
        rows.append(
            (sym, _num(t.get("bidPrice")), _num(t.get("askPrice")), None,
             _num(t.get("quoteVolume")))
        )
    return collect(rows, stats)


# биржи, для которых при пустом результате ccxt пробуем прямой запрос
RAW_FALLBACK = {"weex": weex_raw}


async def fetch_exchange(ex):
    """Возвращает (id биржи, {symbol: (bid, ask, объём_usdt)} или None, текст ошибки, статистика)."""
    stats = defaultdict(int)
    try:
        tickers = await asyncio.wait_for(ex.fetch_tickers(), FETCH_TIMEOUT)
    except Exception as e:
        log.debug("%s: %s", ex.id, e)
        return ex.id, None, (str(e)[:200] or type(e).__name__), stats

    rows = []
    for sym, t in tickers.items():
        vol = t.get("quoteVolume") or (t.get("baseVolume") or 0) * (t.get("last") or 0)
        rows.append((sym, t.get("bid"), t.get("ask"), t.get("timestamp"), vol))
    out = collect(rows, stats)
    stats["sample"] = list(tickers)[:3]

    if not out and ex.id in RAW_FALLBACK:
        raw_stats = defaultdict(int)
        try:
            out = await RAW_FALLBACK[ex.id](ex, raw_stats)
            stats["через_прямой_запрос"] = len(out)
            stats["прямой_запрос_всего"] = raw_stats["total"]
        except Exception as e:
            log.warning("%s: прямой запрос не удался: %s", ex.id, str(e)[:200])
    return ex.id, out, None, stats


def describe(stats):
    keys = ["total", "не_спот_usdt", "нет_bid_ask", "устарела", "малый_объём",
            "через_прямой_запрос", "прямой_запрос_всего"]
    parts = [f"{k}={stats[k]}" for k in keys if stats.get(k)]
    if stats.get("sample"):
        parts.append("примеры=" + ",".join(stats["sample"]))
    return "; ".join(parts)


def find_anomalies(data, min_pct):
    """data: {exchange: {symbol: (bid, ask, vol)}}.
    Аномалия: лучшая цена продажи (макс. bid) выше лучшей цены покупки (мин. ask) не меньше чем на min_pct.
    Для каждой монеты возвращаем до TOP_EXCHANGES лучших бирж для покупки и для продажи."""
    by_symbol = {}
    for ex_id, tick in data.items():
        for sym, v in tick.items():
            by_symbol.setdefault(sym, {})[ex_id] = v

    result = []
    for sym, per_ex in by_symbol.items():
        if len(per_ex) < 2:
            continue
        buys = sorted(((e, v[1], v[2]) for e, v in per_ex.items()), key=lambda t: t[1])
        sells = sorted(((e, v[0], v[2]) for e, v in per_ex.items()), key=lambda t: t[1], reverse=True)
        buy_ex, ask, _ = buys[0]
        sell_ex, bid, _ = sells[0]
        if buy_ex == sell_ex:
            continue
        pct = (bid / ask - 1) * 100
        if min_pct <= pct <= MAX_SPREAD_PCT:
            result.append(
                {
                    "symbol": sym,
                    "buy_ex": buy_ex,
                    "sell_ex": sell_ex,
                    "ask": ask,
                    "bid": bid,
                    "pct": pct,
                    "buys": buys[:TOP_EXCHANGES],     # [(биржа, лучший ask, объём 24ч)]
                    "sells": sells[:TOP_EXCHANGES],   # [(биржа, лучший bid, объём 24ч)]
                }
            )
    result.sort(key=lambda a: a["pct"], reverse=True)
    return result


# ---------- Глубина стакана ----------
def merge_levels(books, side):
    """books: {биржа: стакан}. Склеивает уровни разных бирж в один список (цена, кол-во, биржа):
    asks - по возрастанию цены, bids - по убыванию."""
    levels = []
    for ex_id, book in books.items():
        for lvl in book.get(side) or []:
            try:
                levels.append((float(lvl[0]), float(lvl[1]), ex_id))
            except (TypeError, ValueError, IndexError):
                continue
    levels.sort(key=lambda x: x[0], reverse=(side == "bids"))
    return levels


def depth_orders(asks, bids, thr_pct):
    """asks/bids - склеенные списки (цена, кол-во, биржа). Идём навстречу друг другу:
    покупаем по самым дешёвым ask, продаём по самым дорогим bid, пока разница цен на текущей
    паре уровней не меньше thr_pct. Возвращает выгодные ордера (с биржей) и итоги или None."""
    orders = []
    buy_stats, sell_stats = {}, {}
    cost = revenue = qty_total = 0.0
    i = j = 0
    ask_left = bid_left = None
    while i < len(asks) and j < len(bids):
        pa, qa, ea = asks[i]
        pb, qb, eb = bids[j]
        if pa <= 0 or ea == eb or (pb / pa - 1) * 100 < thr_pct:
            break
        if ask_left is None:
            ask_left = qa
        if bid_left is None:
            bid_left = qb
        take = min(ask_left, bid_left)

        if not orders or orders[-1]["i"] != i:
            orders.append({"i": i, "ex": ea, "price": pa, "qty": 0.0, "rev": 0.0})
        orders[-1]["qty"] += take
        orders[-1]["rev"] += take * pb
        cost += take * pa
        revenue += take * pb
        qty_total += take

        bs = buy_stats.setdefault(ea, {"lo": pa, "hi": pa})
        bs["lo"], bs["hi"] = min(bs["lo"], pa), max(bs["hi"], pa)
        ss = sell_stats.setdefault(eb, {"hi": pb, "lo": pb})
        ss["hi"], ss["lo"] = max(ss["hi"], pb), min(ss["lo"], pb)

        ask_left -= take
        bid_left -= take
        if ask_left <= 1e-12:
            i += 1
            ask_left = None
        if bid_left <= 1e-12:
            j += 1
            bid_left = None

    orders = [o for o in orders if o["qty"] > 0]
    if not orders or cost <= 0:
        return None
    for o in orders:
        o["margin"] = (o["rev"] / (o["qty"] * o["price"]) - 1) * 100
    return {
        "orders": orders,
        "usdt": cost,                 # на сколько $ можно купить
        "qty": qty_total,
        "revenue": revenue,
        "buy_stats": buy_stats,       # {биржа: {"lo", "hi"}} - цены использованных уровней покупки
        "sell_stats": sell_stats,     # {биржа: {"hi", "lo"}} - цены использованных уровней продажи
    }


