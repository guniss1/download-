def side_info(currencies, ex_id, base, key):
    """
    key:
        withdraw — вывод
        deposit  — ввод

    state:
        open    — операция явно разрешена
        closed  — операция явно запрещена
        unknown — данных недостаточно
    """

    entry = currencies.get(ex_id) or {}

    cur = entry.get("cur")

    if not cur:
        return {
            "state": "unknown",
            "nets": {},
        }

    # Не используем устаревшие данные.
    if time.time() - entry.get("time", 0) > CURRENCY_TTL:
        return {
            "state": "unknown",
            "nets": {},
        }

    coin = get_coin(cur, base)

    if not coin:
        return {
            "state": "unknown",
            "nets": {},
        }

    global_flag = coin.get(key)

    # Глобальный запрет операции имеет приоритет.
    if global_flag is False:
        return {
            "state": "closed",
            "nets": {},
        }

    networks = coin.get("networks") or {}

    if networks:
        enabled = {}
        unknown = False

        for net, info in networks.items():
            flag = info.get(key)

            if flag is True:
                enabled[net] = info

            elif flag is None:
                unknown = True

        if enabled:
            return {
                "state": "open",
                "nets": enabled,
                "has_unknown": unknown,
            }

        if unknown:
            return {
                "state": "unknown",
                "nets": {},
            }

        return {
            "state": "closed",
            "nets": {},
        }

    # Нет списка сетей, но глобальный флаг разрешает операцию.
    # Этого недостаточно для строгого подтверждения перевода.
    if global_flag is True:
        return {
            "state": "open",
            "nets": None,
        }

    return {
        "state": "unknown",
        "nets": {},
    }


