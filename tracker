def contract_from(obj):
    """
    Извлекает адрес контракта из явно известных полей.

    Не пытается угадывать адрес по произвольным полям API.
    """

    if not isinstance(obj, dict):
        return None

    keys = (
        "contract",
        "contractAddress",
        "contract_address",
        "tokenAddress",
        "token_address",
        "contractAddr",
    )

    for key in keys:
        value = obj.get(key)

        if isinstance(value, str) and value.strip():
            return value.strip().lower()

    info = obj.get("info")

    if isinstance(info, dict):
        for key in keys:
            value = info.get(key)

            if isinstance(value, str) and value.strip():
                return value.strip().lower()

    return None


def network_name(key, network):
    if isinstance(network, dict):
        return (
            network.get("network")
            or network.get("name")
            or network.get("chain")
            or network.get("id")
            or network.get("code")
            or key
        )

    return key


def normalise_coin(coin):
    """
    Приводит структуру валюты CCXT к общему виду.
    """

    if not isinstance(coin, dict):
        return {}

    raw_nets = coin.get("networks") or {}

    nets = {}

    if isinstance(raw_nets, dict):
        iterable = raw_nets.items()

    elif isinstance(raw_nets, list):
        iterable = [
            (str(i), n)
            for i, n in enumerate(raw_nets)
        ]

    else:
        iterable = []

    for key, n in iterable:
        if not isinstance(n, dict):
            continue

        name = network_name(key, n)
        canon = canonical_network(name)

        if not canon:
            continue

        nets[canon] = {
            "withdraw": parse_bool(
                n.get("withdraw")
            ),
            "deposit": parse_bool(
                n.get("deposit")
            ),
            "contract": contract_from(n),
        }

    return {
        "withdraw": parse_bool(
            coin.get("withdraw")
        ),
        "deposit": parse_bool(
            coin.get("deposit")
        ),
        "networks": nets,
    }


def get_coin(cur, base):
    """
    Ищет валюту без учёта регистра тикера.
    """

    if not isinstance(cur, dict):
        return None

    coin = (
        cur.get(base.upper())
        or cur.get(base.lower())
    )

    if coin is None:
        for code, value in cur.items():
            if str(code).upper() == base.upper():
                coin = value
                break

    if not coin:
        return None

    return normalise_coin(coin)


