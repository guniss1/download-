def parse_bool(value):
    """
    Безопасно разбирает булевы значения из API.

    Важно:
        "false" -> False
        "true"  -> True
        None    -> None

    Неизвестные значения не превращаются в True или False.
    """

    if value is True or value == 1:
        return True

    if value is False or value == 0:
        return False

    if isinstance(value, str):
        value = value.strip().lower()

        if value in (
            "true",
            "1",
            "yes",
            "enabled",
            "enable",
        ):
            return True

        if value in (
            "false",
            "0",
            "no",
            "disabled",
            "disable",
        ):
            return False

    return None


def parse_weex_coins(items):
    """
    Ответ публичного GET /api/v3/coins у WEEX.
    """

    out = {}

    for c in items or []:
        code = str(
            c.get("coin", "")
        ).upper().strip()

        if not code:
            continue

        nets = {}

        for n in c.get("networkList") or []:
            name = (
                n.get("network")
                or n.get("name")
                or n.get("chain")
            )

            if not name:
                continue

            nets[str(name)] = {
                "withdraw": parse_bool(
                    n.get("withdrawEnable")
                ),
                "deposit": parse_bool(
                    n.get("depositEnable")
                ),
                "contract": (
                    n.get("contract")
                    or n.get("contractAddress")
                    or n.get("contract_address")
                ),
            }

        out[code] = {
            "withdraw": parse_bool(
                c.get("withdrawAllEnable")
            ),
            "deposit": parse_bool(
                c.get("depositAllEnable")
            ),
            "networks": nets,
        }

    return out


async def weex_currencies(ex):
    """
    У WEEX статусы монет запрашиваются через публичный endpoint.
    """

    url = "https://api-spot.weex.com/api/v3/coins"

    timeout = aiohttp.ClientTimeout(total=30)

    async with aiohttp.ClientSession(
        trust_env=True,
        timeout=timeout,
    ) as session:

        async with session.get(url) as r:
            r.raise_for_status()
            resp = await r.json(content_type=None)

    items = (
        resp.get("data", resp)
        if isinstance(resp, dict)
        else resp
    )

    return parse_weex_coins(items)


