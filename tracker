def transfer_status(currencies, buy_ex, sell_ex, base):
    """
    True:
        вывод и ввод разрешены,
        общая сеть найдена,
        адреса контрактов совпадают.

    False:
        одна из операций закрыта,
        общей сети нет,
        либо адреса контрактов различаются.

    partial:
        часть информации есть, но строгого подтверждения нет.

    None:
        данных нет вообще.
    """

    w = side_info(
        currencies,
        buy_ex,
        base,
        "withdraw",
    )

    d = side_info(
        currencies,
        sell_ex,
        base,
        "deposit",
    )

    # Если хотя бы одна операция точно закрыта — перевод невозможен.
    if (
        w["state"] == "closed"
        or d["state"] == "closed"
    ):
        return False

    # Нет данных по обеим сторонам.
    if (
        w["state"] == "unknown"
        and d["state"] == "unknown"
    ):
        return None

    # Данные есть только по одной стороне.
    if (
        w["state"] == "unknown"
        or d["state"] == "unknown"
    ):
        return "partial"

    # Обе стороны разрешены, но сеть не раскрыта.
    if (
        w["nets"] is None
        or d["nets"] is None
    ):
        return "partial"

    common = set(w["nets"]) & set(d["nets"])

    if not common:
        # Если есть сети с неизвестным статусом,
        # отсутствие известного пересечения не доказывает невозможность.
        if (
            w.get("has_unknown")
            or d.get("has_unknown")
        ):
            return "partial"

        return False

    missing_contract = False

    for network in common:
        withdraw_contract = (
            w["nets"][network].get("contract")
        )

        deposit_contract = (
            d["nets"][network].get("contract")
        )

        # Оба адреса доступны — сравниваем.
        if withdraw_contract and deposit_contract:
            if withdraw_contract == deposit_contract:
                return True

            # Контракты на одной сети различаются.
            continue

        # Если хотя бы один адрес не предоставлен,
        # нельзя строго подтвердить идентичность токена.
        missing_contract = True

    if missing_contract:
        return "partial"

    # Общая сеть есть, но все доступные адреса контрактов различаются.
    return False


