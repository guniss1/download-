async def currency_loop(app: Application):
    """Фоново обновляет статусы ввода/вывода монет для включённых бирж."""
    exchanges = app.bot_data["exchanges"]
    store = app.bot_data["currencies"]  # {ex_id: {"time": ts, "cur": {код: валюта} | None}}
    while True:
        try:
            wanted = set()
            for c in app.bot_data["cfg"].get("chats", {}).values():
                wanted |= set(EXCHANGES) - set(c.get("disabled", []))
            now = time.time()
            due = [
                e for e in exchanges
                if e.id in wanted and now - store.get(e.id, {}).get("time", 0) > CURRENCY_TTL
            ]
            if due:
                results = await asyncio.gather(*[load_currencies(e) for e in due])
                for ex, (data, err) in zip(due, results):
                    if data:
                        store[ex.id] = {"time": time.time(), "cur": data}
                        log.info("%s: статусы ввода/вывода получены для %d монет", ex.id, len(data))
                    else:
                        prev = store.get(ex.id, {}).get("cur")
                        store[ex.id] = {"time": time.time() - CURRENCY_TTL + CURRENCY_RETRY, "cur": prev}
                        if ex.id not in _cur_warned:
                            _cur_warned.add(ex.id)
                            log.info(
                                "%s: статусов ввода/вывода нет (обычно нужны API-ключи только на чтение). %s",
                                ex.id, err or "",
                            )
        except asyncio.CancelledError:
            raise
        except Exception:
            log.exception("Ошибка в обновлении статусов монет")
        await asyncio.sleep(30)


def _norm(name):
    return re.sub(r"[^A-Z0-9]", "", str(name).upper())


def transfer_status(currencies, buy_ex, sell_ex, base):
    """True - можно вывести с биржи покупки и ввести на бирже продажи (есть общая сеть),
    False - нельзя, None - неизвестно."""
    cb = (currencies.get(buy_ex) or {}).get("cur")
    cs = (currencies.get(sell_ex) or {}).get("cur")
    if not cb or not cs:
        return None
    b, s = cb.get(base), cs.get(base)
    if not b or not s:
        return None

    can_withdraw, can_deposit = b.get("withdraw"), s.get("deposit")
    if can_withdraw is False or can_deposit is False:
        return False

    nets_b, nets_s = b.get("networks") or {}, s.get("networks") or {}
    if nets_b and nets_s:
        out_b = {_norm(k) for k, v in nets_b.items() if (v or {}).get("withdraw") is not False}
        in_s = {_norm(k) for k, v in nets_s.items() if (v or {}).get("deposit") is not False}
        return bool(out_b & in_s)
    if can_withdraw is True and can_deposit is True:
        return True
    return None


# ---------- Форматирование ----------
def trunc1(x):
    """Округление вниз до 0.1 (как в образце: 6.66% -> 6.6%)."""
    return math.floor(x * 10 + 1e-9) / 10


def fmt_vol(v):
    return f"{v / 1e6:.1f}M" if v >= 1e6 else f"{v / 1e3:.0f}K"


def fmt_k(x):
    if x >= 1e6:
        return f"{x / 1e6:.2f}M"
    if x >= 1e3:
        return f"{x / 1e3:.2f}K"
    return f"{x:.2f}"


def fmt_price(p):
    s = f"{p:.10f}".rstrip("0").rstrip(".")
    return s or "0"


def short_price(p):
    """Цена с двумя значащими цифрами: 0.21344 -> 0.21, 0.00123 -> 0.0012."""
    if p <= 0:
        return "0"
    decimals = max(2, -math.floor(math.log10(p)) + 1)
    return f"{p:.{decimals}f}"


def qty_str(q):
    return f"{q:,.0f}".replace(",", " ") if q >= 100 else f"{q:.4g}"


def pair_url(ex_id, symbol):
    base, quote = symbol.split("/")
    return PAIR_URLS[ex_id].format(
        base=base, quote=quote, base_l=base.lower(), quote_l=quote.lower()
    )


def ex_link(ex_id, symbol):
    return f'<a href="{pair_url(ex_id, symbol)}">{EX_NAMES.get(ex_id, ex_id)}</a>'


def price_range(first, second):
    a, b = fmt_price(first), fmt_price(second)
    return a if a == b else f"[{a}:{b}]"


def status_emoji(status):
    return {True: "🟢", False: "🔴"}.get(status, "⚪")


def fmt_anomaly(a):
    orders = a["orders"]
    base = a["symbol"].split("/")[0]
    margins = [o["margin"] for o in orders]
    lo, hi = trunc1(min(margins)), trunc1(max(margins))

    header = f"<b>{a['symbol']} [+{lo:.1f}%:+{hi:.1f}%]</b> {status_emoji(a['transfer'])}"

    body = [f" • <b>Выгодных ордеров:</b> {len(orders)}"]
    for n, o in enumerate(orders[:MAX_ORDER_LINES], 1):
        amount = o["qty"] * o["price"]
        body.append(
            f"{n})+{trunc1(o['margin']):.1f}%: {fmt_price(o['price'])}: "
            f"[${short_price(o['price'])}:${fmt_k(amount)}]: {qty_str(o['qty'])} {base}"
        )
    if len(orders) > MAX_ORDER_LINES:
        body.append(f"…и ещё {len(orders) - MAX_ORDER_LINES}")
    body.append(
        f" • <b>Купля:</b> {ex_link(a['buy_ex'], a['symbol'])} "
        f"{price_range(a['buy_lo'], a['buy_hi'])} (24vol ${fmt_vol(a['vol_buy'])})"
    )
    body.append(
        f" • <b>Продажа:</b> {ex_link(a['sell_ex'], a['symbol'])} "
        f"{price_range(a['sell_hi'], a['sell_lo'])} (24vol ${fmt_vol(a['vol_sell'])})"
    )
    body.append(f" • <b>Доступ к выводу:</b> {status_emoji(a['transfer'])}")

    return header + "\n<blockquote>" + "\n".join(body) + "</blockquote>"


def chunk_blocks(items):
    """items: [(key, text)] -> группы так, чтобы каждое сообщение влезало в лимит Telegram."""
    chunks, cur, size = [], [], 0
    for key, text in items:
        if cur and size + len(text) + 2 > MAX_MESSAGE_CHARS:
            chunks.append(cur)
            cur, size = [], 0
        cur.append((key, text))
        size += len(text) + 2
    if cur:
        chunks.append(cur)
    return chunks


