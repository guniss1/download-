def calibrate(probabilities_in, chat_id):
    rows = db.execute(
        "SELECT top_prob, hit, outcome FROM signals "
        "WHERE resolved=1 AND chat_id=? ORDER BY id DESC LIMIT 300",
        (chat_id,),
    ).fetchall()
    if len(rows) < 100:
        return probabilities_in
    # Shrink confidence toward empirical outcome frequencies only after a minimally
    # meaningful sample. This is a simple correction, not a substitute for calibration.
    freq = {
        k: sum(1 for r in rows if r["outcome"] == k) / len(rows)
        for k in ("long", "short", "flat")
    }
    avg_claim = sum(r["top_prob"] for r in rows) / len(rows)
    hit_rate = sum(r["hit"] for r in rows) / len(rows)
    gap = max(0.0, avg_claim - hit_rate)
    lam = clip(1.0 - gap / max(avg_claim - 1 / 3, 0.05), 0.25, 1.0)
    adjusted = {k: lam * probabilities_in[k] + (1 - lam) * freq[k] for k in freq}
    total = sum(adjusted.values())
    return {k: v / total for k, v in adjusted.items()}


def pct_round(p):
    raw = {k: v * 100 for k, v in p.items()}
    out = {k: int(v) for k, v in raw.items()}
    for k in sorted(raw, key=lambda x: raw[x] - out[x], reverse=True)[:100 - sum(out.values())]:
        out[k] += 1
    return out


def format_signal(symbol, p, analysis, horizon):
    pc = pct_round(p)
    pick = max(p, key=p.get)
    vp = analysis["vp"]
    vp_text = (
        f"POC {vp['poc']:.6g} | VAL {vp['val']:.6g} | VAH {vp['vah']:.6g}"
        if vp else "нет данных"
    )
    lines = [
        f"📊 {symbol} — прогноз на {horizon}",
        f"https://www.binance.com/ru/futures/{symbol}",
        f"🟢 Лонг: {pc['long']}%{' ←' if pick == 'long' else ''}",
        f"🔴 Шорт: {pc['short']}%{' ←' if pick == 'short' else ''}",
        f"⚪ Бок: {pc['flat']}%{' ←' if pick == 'flat' else ''}",
        "",
        "🔎 Аналитика:",
        *[f"• {x}" for x in analysis["reasons"]],
        f"• Volume Profile: {vp_text}",
        "",
        "ℹ️ Проценты — модельная оценка, не гарантированная вероятность.",
    ]
    return "\n".join(lines)


def get_chat(chat_id):
    row = db.execute("SELECT * FROM chats WHERE chat_id=?", (chat_id,)).fetchone()
    if not row:
        db.execute(
            "INSERT INTO chats(chat_id, active, symbols, top_n, horizon_min) VALUES(?,1,'',?,?)",
            (chat_id, DEFAULT_TOP_N, DEFAULT_HORIZON_MIN),
        )
        db.commit()
        row = db.execute("SELECT * FROM chats WHERE chat_id=?", (chat_id,)).fetchone()
    return dict(row)


async def resolve_due(bot):
    now = int(time.time())
    rows = db.execute(
        "SELECT * FROM signals WHERE resolved=0 AND due_ts+5<=? ORDER BY due_ts LIMIT 200",
        (now,),
    ).fetchall()
    for row in rows:
        try:
            exit_price = await BN.price_at(row["symbol"], row["due_ts"])
            ret = exit_price / row["entry"] - 1
            outcome = "long" if ret > row["thr"] else "short" if ret < -row["thr"] else "flat"
            hit = int(outcome == row["pick"])
            db.execute(
                "UPDATE signals SET resolved=1,outcome=?,exit_price=?,hit=? WHERE id=?",
                (outcome, exit_price, hit, row["id"]),
            )
            db.commit()
            message = (
                f"{'🟢' if hit else '🔴'} Результат {row['symbol']}: факт — {RU[outcome]} "
                f"({ret * 100:+.3f}%), прогноз — {RU[row['pick']]} "
                f"({row['top_prob'] * 100:.1f}%)."
            )
            await bot.send_message(
                row["chat_id"], message,
                reply_parameters=ReplyParameters(
                    message_id=row["msg_id"], allow_sending_without_reply=True
                ),
            )
        except Exception as exc:
            log.warning("Не удалось закрыть сигнал %s: %s", row["id"], exc)


async def scan_all(app, only_chat_ids=None):
    async with LOCK:
        q = "SELECT * FROM chats WHERE active=1"
        chats = [dict(x) for x in db.execute(q).fetchall()]
        if only_chat_ids is not None:
            chats = [c for c in chats if c["chat_id"] in only_chat_ids]
        if not chats:
            return

        symbols_by_chat = {}
        all_symbols = set()
        for chat in chats:
            if chat["symbols"].strip():
                symbols = chat["symbols"].split()
            else:
                try:
                    symbols = await BN.top_symbols(int(chat["top_n"]))
                except Exception as exc:
                    log.warning("Не удалось получить топ Binance: %s", exc)
                    symbols = []
            symbols_by_chat[chat["chat_id"]] = symbols
            all_symbols.update(symbols)

        semaphore = asyncio.Semaphore(5)
        results = {}

        async def analyze(symbol):
            async with semaphore:
                try:
                    snap = await BN.snapshot(symbol)
                    # Horizon affects volatility/probability scale and due time;
                    # one data snapshot can be reused for chats with different horizons.
                    results[symbol] = snap
                except Exception as exc:
                    log.info("%s пропущен: %s", symbol, exc)

        await asyncio.gather(*(analyze(s) for s in all_symbols))
        log.info("Сканирование: данные получены для %d/%d монет", len(results), len(all_symbols))

        for chat in chats:
            cid = chat["chat_id"]
            horizon = int(chat["horizon_min"])
            candidates = []
            for symbol in symbols_by_chat.get(cid, []):
                snap = results.get(symbol)
                if not snap:
                    continue
                try:
                    analysis = compute(snap, int(time.time() * 1000), horizon)
                    probs = calibrate(analysis["p"], cid)
                    confidence = max(probs.values())
                    if confidence >= MIN_CONF:
                        candidates.append((confidence, symbol, probs, analysis))
                except BadData as exc:
                    log.debug("%s пропущен: %s", symbol, exc)
                except Exception:
                    log.exception("Ошибка анализа %s", symbol)

            candidates.sort(key=lambda x: x[0], reverse=True)
            for confidence, symbol, probs, analysis in candidates[:MAX_PER_CYCLE]:
                try:
                    msg = await app.bot.send_message(
                        cid,
                        format_signal(symbol, probs, analysis, f"{horizon} минут"),
                        link_preview_options=LinkPreviewOptions(is_disabled=True),
                    )
                    pick = max(probs, key=probs.get)
                    entry_ts = int(analysis["entry_ts"])
                    due_ts = entry_ts + horizon * 60
                    db.execute(
                        """INSERT INTO signals(
                            chat_id,msg_id,symbol,ts,due_ts,entry,thr,p_long,p_short,p_flat,
                            pick,top_prob,reasons
                        ) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)""",
                        (
                            cid, msg.message_id, symbol, entry_ts, due_ts,
                            analysis["price"], analysis["thr"],
                            probs["long"], probs["short"], probs["flat"],
                            pick, probs[pick],
                            json.dumps(analysis["reasons"], ensure_ascii=False),
                        ),
                    )
                    db.commit()
                    await asyncio.sleep(0.35)
                except Forbidden:
                    db.execute("UPDATE chats SET active=0 WHERE chat_id=?", (cid,))
                    db.commit()
                    break
                except Exception as exc:
                    log.warning("Не удалось отправить сигнал в %s: %s", cid, exc)


