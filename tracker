def canonical_network(name):
    """
    Возвращает каноническое имя сети.

    Неизвестные сети остаются отдельными идентификаторами.
    """

    raw = str(name or "").strip().upper()

    compact = re.sub(
        r"[^A-Z0-9]",
        "",
        raw,
    )

    if not compact:
        return None

    return NET_ALIASES.get(
        compact,
        re.sub(
            r"[^A-Z0-9]+",
            "_",
            raw,
        ).strip("_"),
    )


