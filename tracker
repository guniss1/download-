    )


async def cmd_time(update: Update, context: ContextTypes.DEFAULT_TYPE):
    cid = update.effective_chat.id
    get_chat(cid)
    if not context.args:
        current = get_chat(cid)["horizon_min"]
        await update.effective_message.reply_text(
            f"Текущий горизонт: {current} минут. Пример: /time 5M, /time 1H."
        )
        return
    value = context.args[0].upper()
    if value not in HORIZONS:
        await update.effective_message.reply_text(
            "Допустимые значения: " + ", ".join(HORIZONS.keys())
        )
        return
    minutes = HORIZONS[value]
    db.execute("UPDATE chats SET horizon_min=? WHERE chat_id=?", (minutes, cid))
    db.commit()
    await update.effective_message.reply_text(
        f"Горизонт прогноза установлен: {value} ({minutes} минут)."
    )


async def cmd_leaderboard(update: Update, context: ContextTypes.DEFAULT_TYPE):
    cid = update.effective_chat.id
    get_chat(cid)
    if not context.args:
        await update.effective_message.reply_text(
            f"Сейчас анализируется топ-{get_chat(cid)['top_n']} по объёму за 24ч. "
            "Пример: /leaderboard 20"
        )
