async def refresh_books(by_id, keys, cache):
    """keys: [(ex_id, symbol)]. Кладёт свежие стаканы в cache[(ex_id, symbol)] = (время, стакан|None)."""
    books = await asyncio.gather(*[fetch_book(by_id[e], s) for e, s in keys])
    now = time.time()
    for k, b in zip(keys, books):
        cache[k] = (now, b)


