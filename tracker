async def fetch_exchange(ex):
    """
    Возвращает:
        exchange_id,
        данные,
        ошибка,
        статистика.
    """

    stats = defaultdict(int)

    try:
        tickers = await ex.fetch_tickers()

    except Exception as e:
        log.debug("%s: %s", ex.id, e)

        return (
            ex.id,
            None,
            str(e)[:200],
            stats,
        )

    rows = []

    for sym, t in tickers.items():
        vol = (
            t.get("quoteVolume")
            or (t.get("baseVolume") or 0) * (t.get("last") or 0)
        )

        rows.append(
            (
                sym,
                t.get("bid"),
                t.get("ask"),
                t.get("timestamp"),
                vol,
            )
        )

    out = collect(rows, stats)

    stats["sample"] = list(tickers)[:3]

    if not out and ex.id in RAW_FALLBACK:
        raw_stats = defaultdict(int)

        try:
            out = await RAW_FALLBACK[ex.id](ex, raw_stats)

            stats["через_прямой_запрос"] = len(out)
            stats["прямой_запрос_всего"] = raw_stats["total"]

        except Exception as e:
            log.warning(
                "%s: прямой запрос не удался: %s",
                ex.id,
                str(e)[:200],
            )

    return ex.id, out, None, stats


def describe(stats):
    keys = [
        "total",
        "не_спот_usdt",
        "нет_bid_ask",
        "устарела",
        "малый_объём",
        "через_прямой_запрос",
        "прямой_запрос_всего",
    ]

    parts = [
        f"{k}={stats[k]}"
        for k in keys
        if stats.get(k)
    ]

    if stats.get("sample"):
        parts.append(
            "примеры=" + ",".join(stats["sample"])
        )

    return "; ".join(parts)


def find_anomalies(data, min_pct):
    """
    Покупка по минимальному ask.
    Продажа по максимальному bid.
    """

    by_symbol = {}

    for ex_id, tick in data.items():
        for sym, v in tick.items():
            by_symbol.setdefault(sym, {})[ex_id] = v

    result = []

    for sym, per_ex in by_symbol.items():
        if len(per_ex) < 2:
            continue

        buy_ex = min(
            per_ex,
            key=lambda e: per_ex[e][1],
        )

        sell_ex = max(
            per_ex,
            key=lambda e: per_ex[e][0],
        )

        if buy_ex == sell_ex:
            continue

        ask = per_ex[buy_ex][1]
        bid = per_ex[sell_ex][0]

        pct = (bid / ask - 1) * 100

        if min_pct <= pct <= MAX_SPREAD_PCT:
            result.append(
                {
                    "symbol": sym,
                    "buy_ex": buy_ex,
                    "sell_ex": sell_ex,
                    "ask": ask,
                    "bid": bid,
                    "pct": pct,
                    "vol_buy": per_ex[buy_ex][2],
                    "vol_sell": per_ex[sell_ex][2],
                }
            )

    result.sort(
        key=lambda a: a["pct"],
        reverse=True,
    )

    return result


