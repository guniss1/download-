# биржи, для которых статусы берём из публичных эндпоинтов, а ccxt (с ключами) оставляем запасным путём
CURRENCY_OVERRIDE = {
    "weex": weex_currencies,
    "binance": binance_currencies,
    "bitget": bitget_currencies,
}


async def load_currencies(ex):
    """Сначала прямой публичный эндпоинт (если известен), затем ccxt fetch_currencies:
    без ключей он работает только у бирж с публичным статусом монет."""
    loaders = []
    if ex.id in CURRENCY_OVERRIDE:
        loaders.append(lambda: CURRENCY_OVERRIDE[ex.id](ex))
    loaders.append(lambda: ex.fetch_currencies())

    errors = []
    for load in loaders:
        try:
            data = await asyncio.wait_for(load(), 60)
            if data:
                return data, None
        except Exception as e:
            errors.append(str(e)[:150] or type(e).__name__)
    return None, "; ".join(errors)


async def currency_loop(app: Application):
    """Фоново обновляет статусы ввода/вывода монет у включённых бирж."""
    exchanges = app.bot_data["exchanges"]
    store = app.bot_data["currencies"]  # {ex_id: {"time": ts, "cur": {код: валюта} | None}}
    sem = asyncio.Semaphore(CURRENCY_PARALLEL)

    async def guarded(ex):
        async with sem:
            return await load_currencies(ex)

    while True:
        try:
            wanted = set()
            for c in app.bot_data["cfg"].get("chats", {}).values():
                wanted |= set(EXCHANGES) - set(c.get("disabled", []))
            now = time.time()
            due = [
                e for e in exchanges
                if e.id in wanted and now - store.get(e.id, {}).get("time", 0) > CURRENCY_TTL
            ]
            if due:
                results = await asyncio.gather(*[guarded(e) for e in due])
                for ex, (data, err) in zip(due, results):
                    if data:
                        store[ex.id] = {"time": time.time(), "cur": data}
                    else:
                        prev = store.get(ex.id, {}).get("cur")
                        store[ex.id] = {"time": time.time() - CURRENCY_TTL + CURRENCY_RETRY, "cur": prev}
                        if ex.id not in _cur_warned:
                            _cur_warned.add(ex.id)
                            log.info("%s: статусов ввода/вывода нет (%s)", ex.id, err or "пустой ответ")
                got = [e.id for e in due if store[e.id].get("cur")]
                miss = [e.id for e in due if not store[e.id].get("cur")]
                log.info("Статусы ввода/вывода получены: %s | не получены: %s",
                         ", ".join(got) or "-", ", ".join(miss) or "-")
        except asyncio.CancelledError:
            raise
        except Exception:
            log.exception("Ошибка в обновлении статусов монет")
        await asyncio.sleep(30)


NET_ALIASES = {
    "BSC": "BEP20", "BNB": "BEP20", "BNBSMARTCHAIN": "BEP20", "BEP20": "BEP20",
    "ETH": "ERC20", "ETHEREUM": "ERC20", "ERC20": "ERC20",
    "TRX": "TRC20", "TRON": "TRC20", "TRC20": "TRC20",
    "SOL": "SOL", "SOLANA": "SOL",
    "ARB": "ARB", "ARBITRUM": "ARB", "ARBITRUMONE": "ARB",
    "OP": "OP", "OPTIMISM": "OP",
    "MATIC": "POLYGON", "POL": "POLYGON", "POLYGON": "POLYGON",
    "AVAX": "AVAXC", "AVAXC": "AVAXC", "CCHAIN": "AVAXC",
}
NET_STOPWORDS = {"MAINNET", "MAIN", "NETWORK", "CHAIN", "NET", "SMART"}


def net_tokens(name):
    """'BEP20(BSC)' и 'BSC' -> {'BEP20'}: название сети в сравнимом виде."""
    tokens = set(re.findall(r"[A-Z0-9]+", str(name).upper())) - NET_STOPWORDS
    return {NET_ALIASES.get(t, t) for t in tokens}


def side_info(currencies, ex_id, base, key):
    """key: 'withdraw' или 'deposit'. None - данных нет (монеты нет в списке или флаги не заданы);
    {'ok': False} - закрыто; {'ok': True, 'nets': [...] | None} - открыто.
    Флаг None считается НЕИЗВЕСТНЫМ, а не открытым."""
    cur = (currencies.get(ex_id) or {}).get("cur")
    coin = (cur or {}).get(base)
    if not coin:
        return None
    nets = coin.get("networks") or {}
    flags = {k: (v or {}).get(key) for k, v in nets.items()}
    known = {k: f for k, f in flags.items() if f is not None}
    if known:
        enabled = [net_tokens(k) for k, f in known.items() if f]
        if enabled:
            return {"ok": True, "nets": enabled}
        if len(known) == len(flags):
            return {"ok": False, "nets": []}
        return None  # часть сетей закрыта, по остальным флагов нет
    flag = coin.get(key)
    if flag is True:
        return {"ok": True, "nets": None}
    if flag is False:
        return {"ok": False, "nets": []}
    return None


def source_states(currencies, base):
    """Вывод монеты на всех биржах, где статус известен: {биржа: True|False}.
    Биржи без списка статусов или без этой монеты пропускаются."""
    states = {}
    for ex_id in EXCHANGES:
        info = side_info(currencies, ex_id, base, "withdraw")
        if info is not None:
            states[ex_id] = info["ok"]
    return states


def infer_public(states):
    """Вывод по бирже-источникам (нужно минимум MIN_SOURCES):
    True - везде открыт, False - везде закрыт, None - смешанно или данных мало."""
    vals = list(states.values())
    if len(vals) < MIN_SOURCES:
        return None
    if all(v is True for v in vals):
        return True
    if all(v is False for v in vals):
        return False
    return None


def is_dead(currencies, dead_until, base, now):
    """Токен закрыт для вывода везде, где есть данные -> не рассматриваем DEAD_TTL секунд."""
    if dead_until.get(base, 0) > now:
        return True
    if infer_public(source_states(currencies, base)) is False:
        dead_until[base] = now + DEAD_TTL
        return True
    return False


def assess_transfer(currencies, buy_ex, sell_ex, base):
    """Итог: {'status': True|False|'partial'|None, 'public': {биржа: True|False} | None}.
    Сначала точные данные бирж покупки (вывод) и продажи (ввод). Если по одной из них данных нет,
    опираемся на остальные биржи: открыт везде -> считаем, что можно; закрыт везде -> нельзя."""
    w = side_info(currencies, buy_ex, base, "withdraw")
    d = side_info(currencies, sell_ex, base, "deposit")

    if (w and not w["ok"]) or (d and not d["ok"]):
        return {"status": False, "public": None}
    if w is not None and d is not None:
        if w["nets"] is not None and d["nets"] is not None:
            ok = any(a & b for a in w["nets"] for b in d["nets"])
        else:
            ok = True
        return {"status": ok, "public": None}

    public = source_states(currencies, base)
    inferred = infer_public(public)
    if inferred is not None:
        status = inferred
    elif w is not None or d is not None or public:
        status = "partial"
    else:
        status = None
    return {"status": status, "public": public or None}


# ---------- Форматирование ----------
def trunc1(x):
    """Округление вниз до 0.1 (как в образце: 6.66% -> 6.6%)."""
    return math.floor(x * 10 + 1e-9) / 10


def fmt_vol(v):
    return f"{v / 1e6:.1f}M" if v >= 1e6 else f"{v / 1e3:.0f}K"


def fmt_k(x):
    if x >= 1e6:
        return f"{x / 1e6:.2f}M"
    if x >= 1e3:
        return f"{x / 1e3:.2f}K"
    return f"{x:.2f}"


def fmt_price(p):
    s = f"{p:.10f}".rstrip("0").rstrip(".")
    return s or "0"


def short_price(p):
    """Цена с двумя значащими цифрами: 0.21344 -> 0.21, 0.00123 -> 0.0012."""
    if p <= 0:
        return "0"
    decimals = max(2, -math.floor(math.log10(p)) + 1)
    return f"{p:.{decimals}f}"


def qty_str(q):
    return f"{q:,.0f}".replace(",", " ") if q >= 100 else f"{q:.4g}"


def pair_url(ex_id, symbol):
    tpl = PAIR_URLS.get(ex_id)
    if not tpl:
        return None
    base, quote = symbol.split("/")
    try:
        return tpl.format(base=base, quote=quote, base_l=base.lower(), quote_l=quote.lower())
    except (KeyError, IndexError):
        return None


def ex_link(ex_id, symbol):
    name = EX_NAMES.get(ex_id, ex_id)
    url = pair_url(ex_id, symbol)
    return f'<a href="{url}">{name}</a>' if url else name


def price_range(first, second):
    a, b = fmt_price(first), fmt_price(second)
    return a if a == b else f"[{a}:{b}]"


def pub_emoji(state):
    return {True: "🟢", False: "🔴"}.get(state, "⚪")


def status_emoji(status):
    return {True: "🟢", False: "🔴", "partial": "🟡"}.get(status, "⚪")


def fmt_side(title, entries, stats, symbol, sell):
    """entries: [(биржа, лучшая цена, объём 24ч)], stats: цены использованных уровней по биржам."""
    parts = []
    for ex_id, best, vol in entries:
        st = stats.get(ex_id)
        if st:
            rng = price_range(st["hi"], st["lo"]) if sell else price_range(st["lo"], st["hi"])
        else:
            rng = fmt_price(best)
        parts.append(f"{ex_link(ex_id, symbol)} {rng} (24vol ${fmt_vol(vol)})")
    if len(parts) == 1:
        return [f" • <b>{title}:</b> {parts[0]}"]
    return [f" • <b>{title}:</b>"] + [f"{n}) {p}" for n, p in enumerate(parts, 1)]


def fmt_anomaly(a):
    orders = a["orders"]
    base = a["symbol"].split("/")[0]
    margins = [o["margin"] for o in orders]
    lo, hi = trunc1(min(margins)), trunc1(max(margins))

    header = f"<b>{a['symbol']} [+{lo:.1f}%:+{hi:.1f}%]</b> {status_emoji(a['transfer'])}"

    body = [f" • <b>Выгодных ордеров:</b> {len(orders)}"]
    for n, o in enumerate(orders[:MAX_ORDER_LINES], 1):
        amount = o["qty"] * o["price"]
        body.append(
            f"{n}) {EX_NAMES.get(o['ex'], o['ex'])} +{trunc1(o['margin']):.1f}%: "
            f"{fmt_price(o['price'])}: [${short_price(o['price'])}:${fmt_k(amount)}]: "
            f"{qty_str(o['qty'])} {base}"
        )
    if len(orders) > MAX_ORDER_LINES:
        body.append(f"…и ещё {len(orders) - MAX_ORDER_LINES}")
    body += fmt_side("Купля", a["buys_shown"], a["buy_stats"], a["symbol"], sell=False)
    body += fmt_side("Продажа", a["sells_shown"], a["sell_stats"], a["symbol"], sell=True)

    if a.get("public"):
        # закрытые биржи показываем первыми, чтобы они не потерялись при обрезке списка
        items = sorted(a["public"].items(), key=lambda kv: kv[1] is True)
        shown = ", ".join(f"{EX_NAMES.get(ex, ex)} {pub_emoji(st)}" for ex, st in items[:MAX_SOURCES_SHOWN])
        if len(items) > MAX_SOURCES_SHOWN:
            shown += f" (+{len(items) - MAX_SOURCES_SHOWN})"
        body.append(f" • <b>Доступ к выводу:</b> {shown}")
    else:
        body.append(f" • <b>Доступ к выводу:</b> {status_emoji(a['transfer'])}")

    return header + "\n<blockquote>" + "\n".join(body) + "</blockquote>"


def chunk_blocks(items):
    """items: [(key, text)] -> группы так, чтобы каждое сообщение влезало в лимит Telegram."""
    chunks, cur, size = [], [], 0
    for key, text in items:
        if cur and size + len(text) + 2 > MAX_MESSAGE_CHARS:
            chunks.append(cur)
            cur, size = [], 0
        cur.append((key, text))
        size += len(text) + 2
    if cur:
        chunks.append(cur)
    return chunks


# ---------- Цикл сканирования ----------
async def scanner_loop(app: Application):
    exchanges = app.bot_data["exchanges"]
    by_id = {e.id: e for e in exchanges}
    cfg = app.bot_data["cfg"]
    currencies = app.bot_data["currencies"]
    down = set()
    sent = {}
    counted = set()
    book_cache = {}
    dead_until = {}  # токен -> до какого момента не рассматриваем

    def fresh(entry, now):
        return bool(entry) and now - entry[0] <= DEPTH_TTL

    while True:
        try:
            chats = cfg.get("chats", {})
            if chats:
                # опрашиваем только те биржи, которые включены хотя бы в одной группе
                wanted = set()
                for c in chats.values():
                    wanted |= set(EXCHANGES) - set(c.get("disabled", []))
                to_fetch = [e for e in exchanges if e.id in wanted]

                results = await asyncio.gather(*[fetch_exchange(e) for e in to_fetch])
                data = {}
                for ex_id, tick, err, stats in results:
                    if tick is None:
                        if ex_id not in down:
                            log.warning("%s недоступна: %s", ex_id, err)
                            down.add(ex_id)
                    else:
                        if ex_id in down:
                            log.info("%s снова доступна", ex_id)
                            down.discard(ex_id)
                        data[ex_id] = tick
                        if ex_id not in counted:
                            counted.add(ex_id)
                            log.info("%s: %d пар в сканировании (%s)",
                                     ex_id, len(tick), describe(stats))
                app.bot_data["down"] = set(down)

                # 1. кандидаты по каждой группе (по ценам из тикеров)
                now = time.time()
                chat_cands = {}
                cand_all = {}   # ckey -> [лучший процент, [нужные стаканы]]
                for chat_id, c in list(chats.items()):
                    off = set(c.get("disabled", []))
                    chat_data = {k: v for k, v in data.items() if k not in off}
                    if len(chat_data) < 2:
                        continue
                    mode = c.get("transfer", "all")
                    lst = []
                    for a in find_anomalies(chat_data, c["threshold"]):
                        ckey = (a["symbol"], a["buy_ex"], a["sell_ex"])
                        if now - sent.get((chat_id,) + ckey, 0) < COOLDOWN:
                            continue
                        base = a["symbol"].split("/")[0]
                        if mode != "false" and is_dead(currencies, dead_until, base, now):
                            continue
                        assessment = assess_transfer(currencies, a["buy_ex"], a["sell_ex"], base)
                        if mode == "true" and assessment["status"] is not True:
                            continue
                        if mode == "false" and assessment["status"] is not False:
                            continue
                        a["transfer"] = assessment["status"]
                        a["public"] = assessment["public"]
                        lst.append((ckey, a))

                        entry = cand_all.setdefault(ckey, [a["pct"], []])
                        entry[0] = max(entry[0], a["pct"])
                        for ex_id, _, _ in a["buys"] + a["sells"]:
                            k = (ex_id, a["symbol"])
                            if k not in entry[1]:
                                entry[1].append(k)
                    if lst:
                        chat_cands[chat_id] = (c, lst)

                # 2. загружаем стаканы у самых выгодных кандидатов (свежие берём из кэша)
                need_books, checked = [], 0
                for ckey, (_pct, keys) in sorted(cand_all.items(), key=lambda kv: kv[1][0], reverse=True):
                    missing = [k for k in keys if not fresh(book_cache.get(k), now)]
                    if not missing:
                        continue
                    checked += 1
                    if checked > MAX_BOOK_CHECKS:
                        break
                    for k in missing:
                        if k not in need_books:
                            need_books.append(k)
                if need_books:
                    await refresh_books(by_id, need_books, book_cache)

                # 3. считаем ордера по порогу каждой группы и отправляем, если объём достаточный
                now = time.time()
                for chat_id, (c, lst) in chat_cands.items():
                    thr = c["threshold"]
                    min_usd = c.get("min_trade_usdt", MIN_TRADE_USDT)
                    accepted = []
                    for ckey, a in lst:
                        sym = ckey[0]
                        buy_books, sell_books = {}, {}
                        for ex_id, _, _ in a["buys"]:
                            entry = book_cache.get((ex_id, sym))
                            if entry and entry[1] and now - entry[0] <= DEPTH_MAX_AGE:
                                buy_books[ex_id] = entry[1]
                        for ex_id, _, _ in a["sells"]:
                            entry = book_cache.get((ex_id, sym))
                            if entry and entry[1] and now - entry[0] <= DEPTH_MAX_AGE:
                                sell_books[ex_id] = entry[1]
                        if not buy_books or not sell_books:
                            continue
                        info = depth_orders(
                            merge_levels(buy_books, "asks"), merge_levels(sell_books, "bids"), thr
                        )
                        if info is None or info["usdt"] < min_usd:
                            continue
                        full = {
                            **a, **info,
                            "buys_shown": [t for t in a["buys"] if t[0] in buy_books],
                            "sells_shown": [t for t in a["sells"] if t[0] in sell_books],
                        }
                        accepted.append(((chat_id,) + ckey, full))
                    if not accepted:
                        continue

                    shown = accepted[:MAX_PER_MESSAGE]
                    chunks = chunk_blocks([(key, fmt_anomaly(a)) for key, a in shown])
                    for n, chunk in enumerate(chunks):
                        text = "\n\n".join(t for _, t in chunk)
                        if n == len(chunks) - 1 and len(accepted) > len(shown):
                            text += f"\n\n…и ещё {len(accepted) - len(shown)}"
                        try:
                            await app.bot.send_message(
                                int(chat_id), text, parse_mode=ParseMode.HTML, **SEND_KW
                            )
                            for key, _ in chunk:
                                sent[key] = now
                        except Exception as e:
                            log.warning("Не удалось отправить в %s: %s", chat_id, e)
                            break

                if len(sent) > 5000:
                    cutoff = time.time() - COOLDOWN
                    sent = {k: v for k, v in sent.items() if v > cutoff}
                if len(book_cache) > 3000:
                    cutoff = time.time() - DEPTH_MAX_AGE
                    book_cache = {k: v for k, v in book_cache.items() if v[0] > cutoff}
        except asyncio.CancelledError:
            raise
        except Exception:
            log.exception("Ошибка в цикле сканирования")
        await asyncio.sleep(SCAN_INTERVAL)


# ---------- Обработчики Telegram ----------
def normalize(text):
    t = text.lower().replace("ё", "е")
    t = re.sub(r"[^\w\s]", " ", t)
    return " ".join(t.split())


def get_chat(context, update):
    """Настройки текущего чата или None, если чат не подключён."""
    cfg = context.application.bot_data["cfg"]
    return cfg.setdefault("chats", {}).get(str(update.effective_chat.id))


async def on_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg = update.effective_message
    if not msg or not msg.text:
        return
    t = normalize(msg.text)
    if "трекер" in t and "ты тут" in t:
        cfg = context.application.bot_data["cfg"]
        chat_id = str(update.effective_chat.id)
        chats = cfg.setdefault("chats", {})
        new = chat_id not in chats
        chats.setdefault(
            chat_id,
            {"threshold": DEFAULT_THRESHOLD, "disabled": [], "min_trade_usdt": MIN_TRADE_USDT, "transfer": "all"},
        )
        save_config(cfg)
        c = chats[chat_id]
        await msg.reply_text(
            ("Да, тут! Подключился к этой группе. " if new else "Да, тут! ")
            + f"Присылаю разницу цен от {c['threshold']}% между биржами, "
            f"если по стаканам можно провернуть от ${c.get('min_trade_usdt', MIN_TRADE_USDT):g}.\n"
            "Порог: /search 0.5%\n"
            "Минимальный объём: /minsize 100\n"
            "Только переводимые / непереводимые токены: /transfer true | false | all\n"
            "Биржи: /disable binance bybit, /enable binance bybit\n"
            "Настройки: /status"
        )


async def search_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg = update.effective_message
    cfg = context.application.bot_data["cfg"]
    chat = get_chat(context, update)

    if chat is None:
        await msg.reply_text("Сначала напишите в чате: «трекер, ты тут?»")
        return
    if not context.args:
        await msg.reply_text("Формат: /search 0.5%")
        return
    try:
        value = float(context.args[0].replace("%", "").replace(",", "."))
    except ValueError:
        await msg.reply_text("Не понял число. Пример: /search 0.5%")
        return
    if not (0.05 <= value <= MAX_SPREAD_PCT):
        await msg.reply_text(f"Порог должен быть от 0.05% до {MAX_SPREAD_PCT}%.")
        return

    chat["threshold"] = value
    save_config(cfg)
    await msg.reply_text(f"Ищу разницу цен от {value}% между биржами.")


async def minsize_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg = update.effective_message
    cfg = context.application.bot_data["cfg"]
    chat = get_chat(context, update)

    if chat is None:
        await msg.reply_text("Сначала напишите в чате: «трекер, ты тут?»")
        return
    current = chat.get("min_trade_usdt", MIN_TRADE_USDT)
    if not context.args:
        await msg.reply_text(
            f"Сейчас показываю сигналы, где можно провернуть от ${current:g}.\n"
            "Изменить: /minsize 200"
        )
        return
    try:
        value = float(context.args[0].replace("$", "").replace(",", "."))
    except ValueError:
        await msg.reply_text("Не понял число. Пример: /minsize 100")
        return
    if not (1 <= value <= 1_000_000):
        await msg.reply_text("Сумма должна быть от $1 до $1 000 000.")
        return

    chat["min_trade_usdt"] = value
    save_config(cfg)
    await msg.reply_text(f"Показываю только сигналы, где можно провернуть от ${value:g}.")


async def transfer_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg = update.effective_message
    cfg = context.application.bot_data["cfg"]
    chat = get_chat(context, update)

    if chat is None:
        await msg.reply_text("Сначала напишите в чате: «трекер, ты тут?»")
        return
    names = {"all": "all", "все": "all", "off": "all",
             "true": "true", "1": "true", "yes": "true", "да": "true",
             "false": "false", "0": "false", "no": "false", "нет": "false"}
    texts = {
        "all": "Показываю все токены.",
        "true": "Показываю только токены, которые можно передать между биржами (🟢).",
        "false": "Показываю только токены, которые нельзя передать (🔴).",
    }
    arg = context.args[0].lower() if context.args else ""
    if arg not in names:
        await msg.reply_text(
            texts[chat.get("transfer", "all")] + "\nИзменить: /transfer true, /transfer false, /transfer all"
        )
        return
    chat["transfer"] = names[arg]
    save_config(cfg)
    await msg.reply_text(texts[names[arg]])


def parse_names(args):
    names = []
    for raw in args:
        for part in raw.replace(",", " ").split():
            names.append(part.lower())
    return names


async def toggle_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE, enable: bool):
    msg = update.effective_message
    cfg = context.application.bot_data["cfg"]
    chat = get_chat(context, update)
    cmd = "/enable" if enable else "/disable"

    if chat is None:
        await msg.reply_text("Сначала напишите в чате: «трекер, ты тут?»")
        return

    names = parse_names(context.args)
    if not names:
        await msg.reply_text(
            f"Формат: {cmd} binance bybit\nБиржи: " + ", ".join(EXCHANGES)
            + ("\nВключить все: /enable all" if enable else "")
        )
        return

    disabled = set(chat.get("disabled", []))
    unknown = []
    if enable and names == ["all"]:
        disabled.clear()
    else:
        valid = [n for n in names if n in EXCHANGES]
        unknown = [n for n in names if n not in EXCHANGES]
        if enable:
            disabled -= set(valid)
        else:
            disabled |= set(valid)

    chat["disabled"] = [e for e in EXCHANGES if e in disabled]
    save_config(cfg)

    enabled = [e for e in EXCHANGES if e not in disabled]
    lines = []
    if unknown:
        lines.append("Не знаю такие биржи: " + ", ".join(unknown))
    lines.append(f"Включены ({len(enabled)}): " + (", ".join(enabled) or "нет"))
    if disabled:
        lines.append("Выключены: " + ", ".join(e for e in EXCHANGES if e in disabled))
    if len(enabled) < 2:
        lines.append("⚠️ Нужно минимум 2 включённые биржи, иначе сравнивать нечего.")
    await msg.reply_text("\n".join(lines))


async def enable_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await toggle_cmd(update, context, True)


async def disable_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await toggle_cmd(update, context, False)


async def status_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg = update.effective_message
    chat = get_chat(context, update)
    if chat is None:
        await msg.reply_text("Уведомления выключены. Включить: «трекер, ты тут?»")
        return

    bd = context.application.bot_data
    off = set(chat.get("disabled", []))
    enabled = [e for e in EXCHANGES if e not in off]
    lines = [
        f"Уведомления включены, порог {chat['threshold']}%, "
        f"мин. объём ${chat.get('min_trade_usdt', MIN_TRADE_USDT):g}",
        f"Включены ({len(enabled)}): " + (", ".join(enabled) or "нет"),
    ]
    if off:
        lines.append("Выключены: " + ", ".join(e for e in EXCHANGES if e in off))
    unavailable = [e for e in enabled if e in bd.get("down", set())]
    if unavailable:
        lines.append("Не отвечают сейчас: " + ", ".join(unavailable))
    missing = bd.get("missing", [])
    if missing:
        lines.append(
            "Нет в установленной ccxt: " + ", ".join(missing)
            + " (pip install -U ccxt; если не поможет, ccxt эту биржу не поддерживает)"
        )

    store = bd.get("currencies", {})
    known = [e for e in enabled if (store.get(e) or {}).get("cur")]
    unknown = [e for e in enabled if e not in known and e not in missing]
    tmode = {"all": "все токены", "true": "только переводимые (🟢)", "false": "только непереводимые (🔴)"}
    lines.append("Фильтр перевода: " + tmode[chat.get("transfer", "all")])
    lines.append("Статус вывода известен: " + (", ".join(known) or "ни для одной биржи"))
    if unknown:
        lines.append("Статус вывода неизвестен (нужны API-ключи на чтение): " + ", ".join(unknown))
    await msg.reply_text("\n".join(lines))


async def stop_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    cfg = context.application.bot_data["cfg"]
    chats = cfg.setdefault("chats", {})
    if chats.pop(str(update.effective_chat.id), None) is not None:
        save_config(cfg)
        await update.effective_message.reply_text(
            "Уведомления в этом чате выключены. Включить: «трекер, ты тут?»"
        )
    else:
        await update.effective_message.reply_text("Уведомления и так выключены.")


# ---------- Запуск ----------
async def post_init(app: Application):
    cfg = app.bot_data["cfg"]
    exchanges, missing = [], []
    for name in EXCHANGES:
        cls = getattr(ccxt, name, None)
        if cls is None:
            missing.append(name)
            continue
        try:
            exchanges.append(cls(exchange_params(cfg, name)))
        except Exception as e:
            missing.append(name)
            log.warning("%s: не удалось создать биржу: %s", name, e)
    if missing:
        log.warning(
            "В установленной ccxt нет бирж: %s. Обновите: pip install -U ccxt "
            "(если не поможет, ccxt их не поддерживает)",
            ", ".join(missing),
        )
    keyed = [e.id for e in exchanges if getattr(e, "apiKey", None)]
    log.info("API-ключи (чтение) заданы для: %s", ", ".join(keyed) or "нет ни для одной биржи")

    app.bot_data["exchanges"] = exchanges
    app.bot_data["missing"] = missing
    app.bot_data["down"] = set()
    app.bot_data["currencies"] = {}
    app.bot_data["tasks"] = [
        asyncio.create_task(scanner_loop(app)),
        asyncio.create_task(currency_loop(app)),
    ]
    log.info("Бот запущен. Бирж: %d (%s)", len(exchanges), ", ".join(e.id for e in exchanges))


async def post_shutdown(app: Application):
    for task in app.bot_data.get("tasks", []):
        task.cancel()
    for ex in app.bot_data.get("exchanges", []):
        await ex.close()


def main():
    cfg = load_config()
    cfg.setdefault("chats", {})
    token = get_token(cfg)

    app = (
        Application.builder()
        .token(token)
        .post_init(post_init)
        .post_shutdown(post_shutdown)
        .build()
    )
    app.bot_data["cfg"] = cfg
    app.add_handler(CommandHandler("search", search_cmd))
    app.add_handler(CommandHandler("minsize", minsize_cmd))
    app.add_handler(CommandHandler("transfer", transfer_cmd))
    app.add_handler(CommandHandler("enable", enable_cmd))
    app.add_handler(CommandHandler("disable", disable_cmd))
    app.add_handler(CommandHandler("status", status_cmd))
    app.add_handler(CommandHandler("stop", stop_cmd))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, on_text))
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()
