def collect(rows, stats):
    """
    rows:
        (symbol, bid, ask, timestamp_ms, quote_volume)

    Возвращает подходящие спотовые пары USDT.
    """

    now_ms = time.time() * 1000
    out = {}

    for sym, bid, ask, ts, vol in rows:
        stats["total"] += 1

        if not sym.endswith("/" + QUOTE) or ":" in sym:
            stats["не_спот_usdt"] += 1
            continue

        if not bid or not ask or bid <= 0 or ask <= 0:
            stats["нет_bid_ask"] += 1
            continue

        if ts and now_ms - ts > 120_000:
            stats["устарела"] += 1
            continue

        if (vol or 0) < MIN_VOLUME_USDT:
            stats["малый_объём"] += 1
            continue

        out[sym] = (bid, ask, vol)

    return out


def _num(x):
    try:
        return float(x)
    except (TypeError, ValueError):
        return 0.0


async def weex_raw(ex, stats):
    """
    Запасной путь для WEEX:
    публичный ticker/24hr endpoint.
    """

    resp = await ex.publicGetApiV3MarketTicker24hr()

    items = (
        resp.get("data", resp)
        if isinstance(resp, dict)
        else resp
    )

    rows = []

    for t in items or []:
        raw = str(t.get("symbol", ""))

        if not raw.endswith(QUOTE):
            continue

        sym = f"{raw[:-len(QUOTE)]}/{QUOTE}"

        rows.append(
            (
                sym,
                _num(t.get("bidPrice")),
                _num(t.get("askPrice")),
                None,
                _num(t.get("quoteVolume")),
            )
        )

    return collect(rows, stats)


