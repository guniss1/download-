# ───────────────────────── НАСТРОЙКИ ─────────────────────────
BOT_TOKEN = os.getenv("BOT_TOKEN", "")
HORIZON_MIN = 15            # горизонт прогноза
TOP_N = 12                  # сколько самых ликвидных фьючерсов анализировать (если /tokens не задан)
MIN_QUOTE_VOL = 50_000_000  # мин. 24ч-объём в USDT (фильтр низкой ликвидности)
MIN_CONF = 0.40             # слать сигнал, только если у лучшего сценария вероятность >= 40%
MAX_PER_CYCLE = 5           # макс. сигналов за один цикл (антиспам)
FLAT_K = 0.30               # «Бок» = движение меньше 0.30 от типичного 15м-разброса (σ)
MU_SCALE = 0.35             # насколько сильно оценка факторов сдвигает прогноз (на 15м рынок почти случаен)
MAX_SPREAD_PCT = 0.10       # не давать сигнал при спреде больше 0.10%
DB_PATH = "signals.db"
FAPI = "https://fapi.binance.com"
TRIGGER_RE = re.compile(r"сигнал\W+ты\s+тут")
RU = {"long": "Лонг", "short": "Шорт", "flat": "Бок"}

logging.basicConfig(format="%(asctime)s %(levelname)s %(message)s", level=logging.INFO)
log = logging.getLogger("signal_bot")


class BadData(Exception):
    """Плохие/неполные данные — сигнал не выдаём (правило 5 чек-листа)."""


# ───────────────────────── БАЗА (журнал сигналов) ─────────────────────────
db = sqlite3.connect(DB_PATH, check_same_thread=False)
db.row_factory = sqlite3.Row
db.executescript("""
CREATE TABLE IF NOT EXISTS chats(chat_id INTEGER PRIMARY KEY, active INTEGER DEFAULT 1, symbols TEXT DEFAULT '');
CREATE TABLE IF NOT EXISTS signals(
  id INTEGER PRIMARY KEY AUTOINCREMENT, chat_id INTEGER, msg_id INTEGER, symbol TEXT,
  ts INTEGER, due_ts INTEGER, entry REAL, thr REAL,
  p_long REAL, p_short REAL, p_flat REAL, pick TEXT, top_prob REAL, reasons TEXT,
  resolved INTEGER DEFAULT 0, outcome TEXT, exit_price REAL, hit INTEGER);
""")
db.commit()


# ───────────────────────── BINANCE ─────────────────────────
class Binance:
    def __init__(self):
        self.http = httpx.AsyncClient(base_url=FAPI, timeout=10)

    async def get(self, path, **params):
        r = await self.http.get(path, params=params)
        r.raise_for_status()
        return r.json()

    async def all_usdt_symbols(self):
        data = await self.get("/fapi/v1/ticker/24hr")
        return data

    async def top_symbols(self, n):
        data = await self.all_usdt_symbols()
        rows = [d for d in data if re.fullmatch(r"[A-Z0-9]+USDT", d["symbol"])
                and float(d["quoteVolume"]) >= MIN_QUOTE_VOL]
        rows.sort(key=lambda d: -float(d["quoteVolume"]))
        return [d["symbol"] for d in rows[:n]]

    async def snapshot(self, s):
        res = await asyncio.gather(
            self.get("/fapi/v1/klines", symbol=s, interval="15m", limit=120),
            self.get("/fapi/v1/klines", symbol=s, interval="1h", limit=60),
            self.get("/fapi/v1/klines", symbol=s, interval="1m", limit=30),
            self.get("/fapi/v1/depth", symbol=s, limit=20),
            self.get("/fapi/v1/premiumIndex", symbol=s),
            self.get("/futures/data/openInterestHist", symbol=s, period="15m", limit=8),
            self.get("/futures/data/globalLongShortAccountRatio", symbol=s, period="15m", limit=4),
            return_exceptions=True,
        )
        names = ["k15", "k1h", "k1", "depth", "prem", "oi", "ls"]
        d = dict(zip(names, res))
        for must in ("k15", "k1h", "k1", "depth"):
            if isinstance(d[must], Exception):
                raise BadData(f"нет данных {must}: {d[must]}")
        for opt in ("prem", "oi", "ls"):  # деривативы — желательны, но не критичны
            if isinstance(d[opt], Exception):
                d[opt] = None
        return d

    async def price_at(self, s, due_ts):
        """Цена закрытия 1м-свечи, закрывшейся ровно в due_ts."""
        k = await self.get("/fapi/v1/klines", symbol=s, interval="1m",
                           startTime=(due_ts - 60) * 1000, limit=1)
        if not k:
            raise BadData("нет свечи экспирации")
        return float(k[0][4])


BN = Binance()


# ───────────────────────── ИНДИКАТОРЫ ─────────────────────────
def ema(vals, n):
    k, e, out = 2 / (n + 1), vals[0], [vals[0]]
    for v in vals[1:]:
        e = v * k + e * (1 - k)
        out.append(e)
    return out


def rsi(closes, n=14):
    g = l = 0.0
    for i in range(1, n + 1):
        d = closes[i] - closes[i - 1]
        g, l = g + max(d, 0), l + max(-d, 0)
    ag, al = g / n, l / n
    for i in range(n + 1, len(closes)):
        d = closes[i] - closes[i - 1]
        ag = (ag * (n - 1) + max(d, 0)) / n
        al = (al * (n - 1) + max(-d, 0)) / n
    return 100.0 if al == 0 else 100 - 100 / (1 + ag / al)


def clip(x, a=-1.0, b=1.0):
    return max(a, min(b, x))


def sign(x):
    return 1 if x > 0 else -1 if x < 0 else 0


def parse_klines(raw, now_ms):
    """[openTime,o,h,l,c,vol,closeTime,quoteVol,trades,takerBuyBase,...] -> только закрытые свечи."""
    out = []
    for k in raw:
        if int(k[6]) < now_ms:
            out.append((int(k[0]), float(k[1]), float(k[2]), float(k[3]), float(k[4]),
                        float(k[5]), int(k[6]), float(k[7]), int(k[8]), float(k[9])))
    return out


# ───────────────────────── МОДЕЛЬ ─────────────────────────
def norm_cdf(x):
    return 0.5 * (1 + math.erf(x / math.sqrt(2)))


def probs_from(mu, sigma):
    """Доход за 15м ~ Normal(mu, sigma). Бок = |r| < FLAT_K*sigma. Сумма всегда 100%."""
    thr = FLAT_K * sigma
    p_long = 1 - norm_cdf((thr - mu) / sigma)
    p_short = norm_cdf((-thr - mu) / sigma)
    return {"long": p_long, "short": p_short, "flat": 1 - p_long - p_short}, thr


def compute(d, now_ms):
    k15, k1h, k1 = (parse_klines(d[x], now_ms) for x in ("k15", "k1h", "k1"))
    # --- контроль качества данных ---
    if len(k15) < 100 or len(k1h) < 55 or len(k1) < 20:
        raise BadData("мало свечей")
    for kl, step in ((k15, 900_000), (k1h, 3_600_000), (k1, 60_000)):
        if any(b[0] - a[0] != step for a, b in zip(kl[-30:], kl[-29:])):
            raise BadData("пропуски в свечах")
    if now_ms - k1[-1][6] > 180_000:
        raise BadData("данные устарели")
    bids, asks = d["depth"]["bids"], d["depth"]["asks"]
    bid0, ask0 = float(bids[0][0]), float(asks[0][0])
    spread = (ask0 - bid0) / ((ask0 + bid0) / 2) * 100
    if spread > MAX_SPREAD_PCT:
        raise BadData(f"большой спред {spread:.3f}%")

    price = k1[-1][4]
    c15 = [k[4] for k in k15]
    rets = [math.log(c15[i] / c15[i - 1]) for i in range(len(c15) - 64, len(c15))]
    m = sum(rets) / len(rets)
    sigma = max(math.sqrt(sum((r - m) ** 2 for r in rets) / (len(rets) - 1)), 0.0004)

    # 1) ТРЕНД (15м + подтверждение 1ч)
    e9, e50 = ema(c15, 9)[-1], ema(c15, 50)[-1]
    c1h = [k[4] for k in k1h]
    h20, h50 = ema(c1h, 20)[-1], ema(c1h, 50)[-1]
    trend = 0.6 * math.tanh((e9 - e50) / price / (sigma * 3)) + 0.4 * math.tanh((h20 - h50) / price / (sigma * 4))

    # 2) ИМПУЛЬС (MACD-гистограмма)
    macd = [a - b for a, b in zip(ema(c15, 12), ema(c15, 26))]
    hist = macd[-1] - ema(macd, 9)[-1]
    mom = math.tanh(hist / price / sigma * 1.5)

    # 3) ВОЗВРАТ К СРЕДНЕМУ (Bollinger z + RSI + VWAP — одна корзина, т.к. сильно коррелируют)
    w = c15[-20:]
    mean = sum(w) / 20
    std = math.sqrt(sum((x - mean) ** 2 for x in w) / 20) or 1e-12
    z = (price - mean) / std
    mr_z = -clip(abs(z) - 1.5) * sign(z) if abs(z) > 1.5 else 0.0
    r = rsi(c15[-60:])
    mr_r = clip(-(r - 70) / 20) if r > 70 else clip((30 - r) / 20) if r < 30 else 0.0
    last24 = k15[-24:]
    vwap = sum((k[2] + k[3] + k[4]) / 3 * k[5] for k in last24) / (sum(k[5] for k in last24) or 1)
    dev = (price - vwap) / price / sigma
    mr_v = -math.tanh(max(abs(dev) - 1.5, 0)) * sign(dev)
    mr = clip((mr_z + mr_r + mr_v) / 3)

    # 4) ПОТОК ОБЪЁМА (taker buy / sell, RVOL)
    def buy_ratio(kl):
        v = sum(k[5] for k in kl)
        return sum(k[9] for k in kl) / v if v else 0.5
    ratio = 0.5 * buy_ratio(k15[-3:]) + 0.5 * buy_ratio(k1[-15:])
    prev_vol = sum(k[5] for k in k15[-21:-1]) / 20
    rvol = k15[-1][5] / prev_vol if prev_vol else 1.0
    flow = clip(math.tanh((ratio - 0.5) * 12) * clip(rvol, 0.5, 1.5))

    # 5) ДЕРИВАТИВЫ (OI, funding, long/short ratio)
    deriv = 0.0
    try:
        oi = [float(x["sumOpenInterest"]) for x in d["oi"]]
        d_oi = oi[-1] / oi[-5] - 1
        d_p = price / c15[-5] - 1
        dv = math.tanh(d_oi * 100) * math.tanh(d_p / (sigma * 2))
        fund = -math.tanh(float(d["prem"]["lastFundingRate"]) / 0.0005)
        lsv = -math.tanh((float(d["ls"][-1]["longShortRatio"]) - 1) * 1.5)
        deriv = clip(0.5 * dv + 0.3 * fund + 0.2 * lsv)
    except Exception:
        pass  # нет деривативных данных — корзина нейтральна

    # 6) СТАКАН (дисбаланс заявок, малый вес — возможен спуфинг)
    bv = sum(float(p) * float(q) for p, q in bids)
    av = sum(float(p) * float(q) for p, q in asks)
    ob = math.tanh((bv - av) / (bv + av) * 2) if bv + av else 0.0

    parts = {"тренд": 0.20 * trend, "импульс": 0.15 * mom, "возврат": 0.15 * mr,
             "поток": 0.25 * flow, "деривативы": 0.15 * deriv, "стакан": 0.10 * ob}
    score = sum(parts.values())
    mu = score * MU_SCALE * sigma
    p, thr = probs_from(mu, sigma)
    top = sorted(parts.items(), key=lambda kv: -abs(kv[1]))[:2]
    return {"price": price, "p": p, "thr": thr, "sigma": sigma, "score": score,
            "entry_ts": round(k1[-1][6] / 1000),
            "reasons": ", ".join(f"{n} {v:+.2f}" for n, v in top)}


def calibrate(p, chat_id):
    """Если бот переоценивал себя на истории — сжимаем вероятности к частотам исходов (правило 2 чек-листа)."""
    rows = db.execute("SELECT top_prob, hit, outcome FROM signals WHERE resolved=1 AND chat_id=? "
                      "ORDER BY id DESC LIMIT 300", (chat_id,)).fetchall()
    if len(rows) < 40:
        return p
    avg_top = sum(r["top_prob"] for r in rows) / len(rows)
    hit = sum(r["hit"] for r in rows) / len(rows)
    gap = avg_top - hit
    if gap <= 0:
        return p
    lam = max(0.2, 1 - gap / max(avg_top - 1 / 3, 0.05))
    freq = {k: sum(1 for r in rows if r["outcome"] == k) / len(rows) for k in p}
    return {k: lam * p[k] + (1 - lam) * freq[k] for k in p}


def pct_round(p):
    raw = {k: v * 100 for k, v in p.items()}
    fl = {k: int(v) for k, v in raw.items()}
    for k in sorted(raw, key=lambda k: raw[k] - fl[k], reverse=True)[:100 - sum(fl.values())]:
        fl[k] += 1
    return fl


def format_signal(symbol, p):
    pc = pct_round(p)
    best = max(p, key=p.get)
    base = symbol[:-4]
    mark = lambda k: " — более вероятный" if k == best else ""
    return (f"Инфо {base} для {HORIZON_MIN}M\n"
            f"https://www.binance.com/ru/futures/{symbol}\n"
            f"Лонг {pc['long']}%{mark('long')}\n"
            f"Шорт {pc['short']}%{mark('short')}\n"
            f"Бок {pc['flat']}%{mark('flat')}")


def classify(entry, exit_, thr):
    r = exit_ / entry - 1
    return ("long" if r > thr else "short" if r < -thr else "flat"), r


# ───────────────────────── ЦИКЛЫ ─────────────────────────
LOCK = asyncio.Lock()


async def run_cycle(app, chat_ids=None):
    async with LOCK:
        q = "SELECT chat_id, symbols FROM chats WHERE active=1"
        chats = [dict(r) for r in db.execute(q) if chat_ids is None or r["chat_id"] in chat_ids]
        if not chats:
            return
        try:
            auto = await BN.top_symbols(TOP_N)
        except Exception as e:
            log.warning("не получил список токенов: %s", e)
            return
        wanted = set()
        for c in chats:
            c["syms"] = c["symbols"].split() or auto
            wanted.update(c["syms"])

        sem = asyncio.Semaphore(6)
        results = {}

        async def one(sym):
            async with sem:
                try:
                    results[sym] = compute(await BN.snapshot(sym), int(time.time() * 1000))
                except BadData as e:
                    log.info("%s пропущен: %s", sym, e)
                except Exception as e:
                    log.warning("%s ошибка: %s", sym, e)

        await asyncio.gather(*(one(s) for s in wanted))

        for c in chats:
            cands = []
            for s in c["syms"]:
                res = results.get(s)
                if res:
                    p = calibrate(res["p"], c["chat_id"])
                    cands.append((max(p.values()), s, p, res))
            cands = sorted((x for x in cands if x[0] >= MIN_CONF), key=lambda x: -x[0])[:MAX_PER_CYCLE]
            for top, s, p, res in cands:
                try:
                    msg = await app.bot.send_message(
                        c["chat_id"], format_signal(s, p),
                        link_preview_options=LinkPreviewOptions(is_disabled=True))
                except Forbidden:
                    db.execute("UPDATE chats SET active=0 WHERE chat_id=?", (c["chat_id"],))
                    db.commit()
                    break
                except Exception as e:
                    log.warning("не отправил в %s: %s", c["chat_id"], e)
                    continue
                pick = max(p, key=p.get)
                db.execute(
                    "INSERT INTO signals(chat_id,msg_id,symbol,ts,due_ts,entry,thr,p_long,p_short,p_flat,"
                    "pick,top_prob,reasons) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?)",
                    (c["chat_id"], msg.message_id, s, res["entry_ts"], res["entry_ts"] + HORIZON_MIN * 60,
                     res["price"], res["thr"], p["long"], p["short"], p["flat"], pick, p[pick],
                     json.dumps(res["reasons"], ensure_ascii=False)))
                db.commit()
                await asyncio.sleep(1.2)


async def job_cycle(context: ContextTypes.DEFAULT_TYPE):
    await run_cycle(context.application)


async def job_check(context: ContextTypes.DEFAULT_TYPE):
    """Проверка сигналов, у которых истекли 15 минут."""
    now = int(time.time())
    for r in db.execute("SELECT * FROM signals WHERE resolved=0 AND due_ts+3<=?", (now,)).fetchall():
        try:
            exit_price = await BN.price_at(r["symbol"], r["due_ts"])
        except Exception as e:
            log.warning("проверка %s отложена: %s", r["symbol"], e)
            continue
        outcome, ret = classify(r["entry"], exit_price, r["thr"])
        hit = int(outcome == r["pick"])
        db.execute("UPDATE signals SET resolved=1, outcome=?, exit_price=?, hit=? WHERE id=?",
                   (outcome, exit_price, hit, r["id"]))
        db.commit()
        text = (f"{'🟢' if hit else '🔴'} {r['symbol'][:-4]}: факт — {RU[outcome]} ({ret * 100:+.2f}%), "
                f"прогноз был — {RU[r['pick']]} {round(r['top_prob'] * 100)}%")
        try:
            await context.bot.send_message(
                r["chat_id"], text,
                reply_parameters=ReplyParameters(message_id=r["msg_id"], allow_sending_without_reply=True))
        except Exception as e:
            log.warning("не отправил результат: %s", e)


# ───────────────────────── TELEGRAM ─────────────────────────
async def on_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg = update.effective_message
    if not msg or not msg.text:
        return
    if TRIGGER_RE.search(msg.text.lower().replace("ё", "е")):
        cid = msg.chat_id
        db.execute("INSERT INTO chats(chat_id, active) VALUES(?,1) "
                   "ON CONFLICT(chat_id) DO UPDATE SET active=1", (cid,))
        db.commit()
        await msg.reply_text(
            f"Да, я тут 👋 Начинаю работу: прогноз на {HORIZON_MIN} минут каждые {HORIZON_MIN} минут, "
            f"через {HORIZON_MIN} минут проверю себя (🟢/🔴).\n"
            "Команды: /tokens BTC ETH TON — свой список (/tokens auto — сброс), /stats — моя точность, /stop — пауза.")
        context.application.create_task(run_cycle(context.application, [cid]))


async def cmd_stop(update: Update, context: ContextTypes.DEFAULT_TYPE):
    db.execute("UPDATE chats SET active=0 WHERE chat_id=?", (update.effective_chat.id,))
    db.commit()
    await update.effective_message.reply_text("Ставлю на паузу. Чтобы вернуть — «сигнал, ты тут?»")


async def cmd_tokens(update: Update, context: ContextTypes.DEFAULT_TYPE):
    cid = update.effective_chat.id
    args = [a.upper().replace("/", "").replace("-", "") for a in context.args]
    if not args or args == ["AUTO"]:
        db.execute("INSERT INTO chats(chat_id, symbols) VALUES(?, '') ON CONFLICT(chat_id) DO UPDATE SET symbols=''", (cid,))
        db.commit()
        await update.effective_message.reply_text(f"Режим авто: топ-{TOP_N} фьючерсов Binance по объёму.")
        return
    syms = [a if a.endswith("USDT") else a + "USDT" for a in args]
    try:
        valid = {d["symbol"] for d in await BN.all_usdt_symbols()}
    except Exception:
        await update.effective_message.reply_text("Не смог проверить список токенов, попробуй позже.")
        return
    ok, bad = [s for s in syms if s in valid], [s for s in syms if s not in valid]
    if ok:
        db.execute("INSERT INTO chats(chat_id, symbols) VALUES(?,?) "
                   "ON CONFLICT(chat_id) DO UPDATE SET symbols=excluded.symbols", (cid, " ".join(ok)))
        db.commit()
    await update.effective_message.reply_text(
        (f"Слежу за: {', '.join(s[:-4] for s in ok)}. " if ok else "") +
        (f"Не нашёл на Binance Futures: {', '.join(bad)}." if bad else ""))


async def cmd_stats(update: Update, context: ContextTypes.DEFAULT_TYPE):
    rows = db.execute("SELECT * FROM signals WHERE resolved=1 AND chat_id=?",
                      (update.effective_chat.id,)).fetchall()
    if not rows:
        await update.effective_message.reply_text("Пока нет проверенных сигналов.")
        return
    n = len(rows)
    hit = sum(r["hit"] for r in rows) / n
    claimed = sum(r["top_prob"] for r in rows) / n
    last = rows[-50:]
    lines = [f"Проверено сигналов: {n}",
             f"Попаданий 🟢: {hit * 100:.1f}% (последние {len(last)}: {sum(r['hit'] for r in last) / len(last) * 100:.1f}%)",
             f"Средняя заявленная уверенность: {claimed * 100:.1f}%"]
    for k in ("long", "short", "flat"):
        sub = [r for r in rows if r["pick"] == k]
        if sub:
            lines.append(f"  прогноз {RU[k]}: {len(sub)} шт, попал {sum(r['hit'] for r in sub) / len(sub) * 100:.0f}%")
    lines.append("Случайное угадывание из 3 исходов ≈ 33%. Верить процентам стоит, когда заявленная "
                 "уверенность ≈ реальные попадания на 100+ сигналах.")
    await update.effective_message.reply_text("\n".join(lines))


def secs_to_next_quarter():
    t = time.time()
    return HORIZON_MIN * 60 - (t % (HORIZON_MIN * 60))


def main():
    if not BOT_TOKEN:
        raise SystemExit("Задай токен: export BOT_TOKEN='123:ABC...'")
    app = Application.builder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler("stop", cmd_stop))
    app.add_handler(CommandHandler("tokens", cmd_tokens))
    app.add_handler(CommandHandler("stats", cmd_stats))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, on_text))
    # циклы выровнены по границам 15м-свечей (:00 :15 :30 :45), +5с чтобы свеча точно закрылась
    app.job_queue.run_repeating(job_cycle, interval=HORIZON_MIN * 60, first=secs_to_next_quarter() + 5)
    app.job_queue.run_repeating(job_check, interval=10, first=10)
    log.info("Бот запущен. Первый цикл через %.0f с", secs_to_next_quarter() + 5)
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()
