        f"Горизонт: {c['horizon_min']} минут\n"
        f"Монеты: {mode}\n"
        f"Порог сигнала: {MIN_CONF * 100:.0f}% (эвристическая оценка)"
    )


async def cmd_stats(update: Update, context: ContextTypes.DEFAULT_TYPE):
    rows = db.execute(
        "SELECT * FROM signals WHERE resolved=1 AND chat_id=? ORDER BY id DESC",
        (update.effective_chat.id,),
    ).fetchall()
    if not rows:
        await update.effective_message.reply_text("Пока нет завершённых сигналов.")
        return
    n = len(rows)
    hit = sum(r["hit"] for r in rows) / n
    last = rows[:min(100, n)]
    last_hit = sum(r["hit"] for r in last) / len(last)
    claimed = sum(r["top_prob"] for r in rows) / n
    lines = [
        f"Проверено сигналов: {n}",
        f"Попадания всего: {hit * 100:.1f}%",
        f"Последние {len(last)}: {last_hit * 100:.1f}%",
        f"Средняя заявленная оценка: {claimed * 100:.1f}%",
        "",
    ]
    for key in ("long", "short", "flat"):
        subset = [r for r in rows if r["pick"] == key]
        if subset:
            lines.append(
                f"{RU[key]}: {len(subset)} сигналов, "
                f"совпадений {sum(r['hit'] for r in subset) / len(subset) * 100:.1f}%"
            )
    lines.append(
        "Важно: совпадение направления не равно прибыльности. "
        "Статистика не учитывает комиссии, проскальзывание и исполнение."
    )
    await update.effective_message.reply_text("\n".join(lines))


async def on_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg = update.effective_message
    if not msg or not msg.text:
        return
    normalized = msg.text.lower().replace("ё", "е")
    if TRIGGER_RE.search(normalized):
        c = get_chat(msg.chat_id)
        db.execute("UPDATE chats SET active=1 WHERE chat_id=?", (msg.chat_id,))
        db.commit()
        await msg.reply_text(
            f"Я здесь. Запускаю анализ. Горизонт: {c['horizon_min']} минут. "
            f"Список: {'ручной' if c['symbols'] else 'топ-' + str(c['top_n']) + ' Binance'}.\n"
            "Настройки: /time 5M, /leaderboard 20. Статистика: /stats."
        )
        context.application.create_task(scan_all(context.application, [msg.chat_id]))


async def scan_job(context: ContextTypes.DEFAULT_TYPE):
    await scan_all(context.application)


async def resolve_job(context: ContextTypes.DEFAULT_TYPE):
    await resolve_due(context.bot)


async def post_shutdown(app: Application):
    await BN.http.aclose()


def main():
    if not BOT_TOKEN:
        raise SystemExit("Задай переменную окружения BOT_TOKEN.")
    app = Application.builder().token(BOT_TOKEN).post_shutdown(post_shutdown).build()
    app.add_handler(CommandHandler("start", cmd_start))
    app.add_handler(CommandHandler("time", cmd_time))
    app.add_handler(CommandHandler("leaderboard", cmd_leaderboard))
    app.add_handler(CommandHandler("tokens", cmd_tokens))
    app.add_handler(CommandHandler("stop", cmd_stop))
    app.add_handler(CommandHandler("status", cmd_status))
    app.add_handler(CommandHandler("stats", cmd_stats))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, on_text))
    app.job_queue.run_repeating(scan_job, interval=SCAN_INTERVAL_SEC, first=10)
    app.job_queue.run_repeating(resolve_job, interval=10, first=10)
    log.info("Signal Bot PRO запущен.")
    app.run_polling(allowed_updates=Update.ALL_TYPES)


if __name__ == "__main__":
    main()
