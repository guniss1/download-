async def scanner_loop(app: Application):
    exchanges = app.bot_data["exchanges"]

    by_id = {
        e.id: e
        for e in exchanges
    }

    cfg = app.bot_data["cfg"]
    currencies = app.bot_data["currencies"]

    down = set()
    sent = {}
    counted = set()
    book_cache = {}

    def fresh(entry, now):
        return (
            bool(entry)
            and now - entry[0] <= DEPTH_TTL
        )

    while True:
        try:
            chats = cfg.get("chats", {})

            if chats:
                wanted = set()

                for c in chats.values():
                    wanted |= (
                        set(EXCHANGES)
                        - set(c.get("disabled", []))
                    )

                to_fetch = [
                    e
                    for e in exchanges
                    if e.id in wanted
                ]

                results = await asyncio.gather(
                    *[
                        fetch_exchange(e)
                        for e in to_fetch
                    ]
                )

                data = {}

                for ex_id, tick, err, stats in results:
                    if tick is None:
                        if ex_id not in down:
                            log.warning(
                                "%s недоступна: %s",
                                ex_id,
                                err,
                            )

                            down.add(ex_id)

                    else:
                        if ex_id in down:
                            log.info(
                                "%s снова доступна",
                                ex_id,
                            )

                            down.discard(ex_id)

                        data[ex_id] = tick

                        if ex_id not in counted:
                            counted.add(ex_id)

                            log.info(
                                "%s: %d пар в сканировании (%s)",
                                ex_id,
                                len(tick),
                                describe(stats),
                            )

                app.bot_data["down"] = set(down)

                # 1. Поиск кандидатов по ценам.

                now = time.time()

                chat_cands = {}
                cand_all = {}

                for chat_id, c in list(chats.items()):
                    off = set(
                        c.get("disabled", [])
                    )

                    chat_data = {
                        k: v
                        for k, v in data.items()
                        if k not in off
                    }

                    if len(chat_data) < 2:
                        continue

                    lst = []

                    threshold = c.get(
                        "threshold",
                        DEFAULT_THRESHOLD,
                    )

                    for a in find_anomalies(
                        chat_data,
                        threshold,
                    ):
                        ckey = (
                            a["symbol"],
                            a["buy_ex"],
                            a["sell_ex"],
                        )

                        if (
                            now - sent.get(
                                (chat_id,) + ckey,
                                0,
                            ) < COOLDOWN
                        ):
                            continue

                        lst.append((ckey, a))

                        cand_all[ckey] = max(
                            cand_all.get(ckey, 0),
                            a["pct"],
                        )

                    if lst:
                        chat_cands[chat_id] = (c, lst)

                # 2. Получение стаканов.

                need_books = []
                checked = 0

                for ckey, _pct in sorted(
                    cand_all.items(),
                    key=lambda kv: kv[1],
                    reverse=True,
                ):
                    sym, buy_ex, sell_ex = ckey

                    missing = [
                        (e, sym)
                        for e in (buy_ex, sell_ex)
                        if not fresh(
                            book_cache.get((e, sym)),
                            now,
                        )
                    ]

                    if not missing:
                        continue

                    checked += 1

                    if checked > MAX_BOOK_CHECKS:
                        break

                    for k in missing:
                        if k not in need_books:
                            need_books.append(k)

                if need_books:
                    await refresh_books(
                        by_id,
                        need_books,
                        book_cache,
                    )

                # 3. Проверка стаканов и отправка.

                now = time.time()

                for chat_id, (c, lst) in chat_cands.items():
                    thr = c.get(
                        "threshold",
                        DEFAULT_THRESHOLD,
                    )

                    min_usd = c.get(
                        "min_trade_usdt",
                        MIN_TRADE_USDT,
                    )

                    accepted = []

                    for ckey, a in lst:
                        sym, buy_ex, sell_ex = ckey

                        bb = book_cache.get(
                            (buy_ex, sym)
                        )

                        sb = book_cache.get(
                            (sell_ex, sym)
                        )

                        if (
                            not bb
                            or not sb
                            or not bb[1]
                            or not sb[1]
                        ):
                            continue

                        if (
                            now - bb[0] > DEPTH_MAX_AGE
                            or now - sb[0] > DEPTH_MAX_AGE
                        ):
                            continue

                        info = depth_orders(
                            bb[1].get("asks", []),
                            sb[1].get("bids", []),
                            thr,
                        )

                        if (
                            info is None
                            or info["usdt"] < min_usd
                        ):
                            continue

                        info["transfer"] = transfer_status(
                            currencies,
                            buy_ex,
                            sell_ex,
                            sym.split("/")[0],
                        )

                        accepted.append(
                            (
                                (chat_id,) + ckey,
                                {
                                    **a,
                                    **info,
                                },
                            )
                        )

                    if not accepted:
                        continue

                    shown = accepted[:MAX_PER_MESSAGE]

                    chunks = chunk_blocks(
                        [
                            (key, fmt_anomaly(a))
                            for key, a in shown
                        ]
                    )

                    for n, chunk in enumerate(chunks):
                        text = "\n\n".join(
                            t
                            for _, t in chunk
                        )

                        if (
                            n == len(chunks) - 1
                            and len(accepted) > len(shown)
                        ):
                            text += (
                                f"\n\n…и ещё "
                                f"{len(accepted) - len(shown)}"
                            )

                        try:
                            await app.bot.send_message(
                                int(chat_id),
                                text,
                                parse_mode=ParseMode.HTML,
                                **SEND_KW,
                            )

                            for key, _ in chunk:
                                sent[key] = now

                        except Exception as e:
                            log.warning(
                                "Не удалось отправить в %s: %s",
                                chat_id,
                                e,
                            )

                            break

                # Очистка старых записей.

                if len(sent) > 5000:
                    cutoff = time.time() - COOLDOWN

                    sent = {
                        k: v
                        for k, v in sent.items()
                        if v > cutoff
                    }

                if len(book_cache) > 3000:
                    cutoff = time.time() - DEPTH_MAX_AGE

                    book_cache = {
                        k: v
                        for k, v in book_cache.items()
                        if v[0] > cutoff
                    }

        except asyncio.CancelledError:
            raise

        except Exception:
            log.exception(
                "Ошибка в цикле сканирования"
            )

        await asyncio.sleep(SCAN_INTERVAL)


