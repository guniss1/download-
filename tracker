async def post_init(app: Application):
    cfg = app.bot_data["cfg"]

    exchanges = []
    missing = []

    for name in EXCHANGES:
        cls = getattr(ccxt, name, None)

        if cls is None:
            missing.append(name)
            continue

        exchanges.append(
            cls(exchange_params(cfg, name))
        )

    if missing:
        log.warning(
            "В установленной ccxt нет бирж: %s. "
            "Обновите ccxt: pip install -U ccxt",
            ", ".join(missing),
        )

    keyed = [
        e.id
        for e in exchanges
        if getattr(e, "apiKey", None)
    ]

    log.info(
        "API-ключи (чтение) заданы для: %s",
        ", ".join(keyed) or "нет ни для одной биржи",
    )

    app.bot_data["exchanges"] = exchanges
    app.bot_data["missing"] = missing
    app.bot_data["down"] = set()
    app.bot_data["currencies"] = {}

    app.bot_data["tasks"] = [
        asyncio.create_task(
            scanner_loop(app)
        ),
        asyncio.create_task(
            currency_loop(app)
        ),
    ]

    log.info(
        "Бот запущен. Биржи: %s",
        ", ".join(e.id for e in exchanges),
    )


async def post_shutdown(app: Application):
    for task in app.bot_data.get("tasks", []):
        task.cancel()

    if app.bot_data.get("tasks"):
        await asyncio.gather(
            *app.bot_data["tasks"],
            return_exceptions=True,
        )

    for ex in app.bot_data.get("exchanges", []):
        try:
            await ex.close()

        except Exception:
            log.exception(
                "Ошибка закрытия %s",
                ex.id,
            )


def main():
    cfg = load_config()

    cfg.setdefault(
        "chats",
        {},
    )

    token = get_token(cfg)

    app = (
        Application.builder()
        .token(token)
        .post_init(post_init)
        .post_shutdown(post_shutdown)
        .build()
    )

    app.bot_data["cfg"] = cfg

    app.add_handler(
        CommandHandler("search", search_cmd)
    )

    app.add_handler(
        CommandHandler("minsize", minsize_cmd)
    )

    app.add_handler(
        CommandHandler("enable", enable_cmd)
    )

    app.add_handler(
        CommandHandler("disable", disable_cmd)
    )

    app.add_handler(
        CommandHandler("status", status_cmd)
    )

    app.add_handler(
        CommandHandler("stop", stop_cmd)
    )

    app.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            on_text,
        )
    )

    app.run_polling(
        allowed_updates=Update.ALL_TYPES
    )


if __name__ == "__main__":
    main()
