class Binance:
    def __init__(self):
        self.http = httpx.AsyncClient(
            base_url=FAPI,
            timeout=httpx.Timeout(12.0),
            limits=httpx.Limits(max_connections=30, max_keepalive_connections=15),
            headers={"User-Agent": "SignalBotPRO/1.0"},
        )
        self._symbols_cache = []
        self._symbols_cache_ts = 0

    async def get(self, path: str, **params):
        r = await self.http.get(path, params=params)
        r.raise_for_status()
        return r.json()

    async def tradable_usdt_perpetuals(self):
        now = time.time()
        if self._symbols_cache and now - self._symbols_cache_ts < 1800:
            return self._symbols_cache
        info = await self.get("/fapi/v1/exchangeInfo")
        valid = {
            x["symbol"] for x in info.get("symbols", [])
            if x.get("status") == "TRADING"
            and x.get("quoteAsset") == "USDT"
            and x.get("contractType") == "PERPETUAL"
        }
        self._symbols_cache = sorted(valid)
        self._symbols_cache_ts = now
        return self._symbols_cache

    async def top_symbols(self, n: int):
        tickers, valid = await asyncio.gather(
            self.get("/fapi/v1/ticker/24hr"),
            self.tradable_usdt_perpetuals(),
        )
        valid_set = set(valid)
        rows = [
            x for x in tickers
            if x.get("symbol") in valid_set
            and float(x.get("quoteVolume", 0)) >= MIN_QUOTE_VOL
        ]
        rows.sort(key=lambda x: float(x.get("quoteVolume", 0)), reverse=True)
        return [x["symbol"] for x in rows[:max(1, min(n, MAX_SYMBOLS_ALLOWED))]]

    async def snapshot(self, symbol: str):
        calls = {
            "k1": self.get("/fapi/v1/klines", symbol=symbol, interval="1m", limit=240),
            "k5": self.get("/fapi/v1/klines", symbol=symbol, interval="5m", limit=180),
            "k15": self.get("/fapi/v1/klines", symbol=symbol, interval="15m", limit=160),
            "k1h": self.get("/fapi/v1/klines", symbol=symbol, interval="1h", limit=100),
            "k4h": self.get("/fapi/v1/klines", symbol=symbol, interval="4h", limit=80),
            "depth": self.get("/fapi/v1/depth", symbol=symbol, limit=50),
            "prem": self.get("/fapi/v1/premiumIndex", symbol=symbol),
            "oi_now": self.get("/fapi/v1/openInterest", symbol=symbol),
            "oi_hist": self.get("/futures/data/openInterestHist", symbol=symbol, period="5m", limit=12),
            "ls": self.get("/futures/data/globalLongShortAccountRatio", symbol=symbol, period="5m", limit=6),
            "trades": self.get("/fapi/v1/aggTrades", symbol=symbol, limit=1000),
            "liqs": self.get("/fapi/v1/allForceOrders", symbol=symbol, limit=100),
        }
        names = list(calls)
        values = await asyncio.gather(*calls.values(), return_exceptions=True)
        d = dict(zip(names, values))
        for key in ("k1", "k5", "k15", "k1h", "k4h", "depth", "trades"):
            if isinstance(d[key], Exception):
                raise BadData(f"{key}: {d[key]}")
        for key in ("prem", "oi_now", "oi_hist", "ls", "liqs"):
            if isinstance(d[key], Exception):
                d[key] = None
        return d

    async def price_at(self, symbol: str, due_ts: int):
        # Kline opened in the minute immediately before due_ts; return its close.
        rows = await self.get(
            "/fapi/v1/klines", symbol=symbol, interval="1m",
            endTime=due_ts * 1000 - 1, limit=1
        )
        if not rows:
            raise BadData("нет минутной свечи для экспирации")
        return float(rows[0][4])


