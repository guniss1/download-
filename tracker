def parse_klines(raw, now_ms):
    out = []
    for k in raw:
        if int(k[6]) < now_ms:
            out.append({
                "t": int(k[0]), "o": float(k[1]), "h": float(k[2]),
                "l": float(k[3]), "c": float(k[4]), "v": float(k[5]),
                "qv": float(k[7]), "trades": int(k[8]), "tb": float(k[9]),
                "taker_quote": float(k[10]),
            })
    return out


def ema(values, period):
    if not values:
        return []
    alpha = 2.0 / (period + 1)
    out, current = [values[0]], values[0]
    for value in values[1:]:
        current = alpha * value + (1 - alpha) * current
        out.append(current)
    return out


def rsi(values, period=14):
    if len(values) <= period:
        return 50.0
    gains, losses = [], []
    for a, b in zip(values[:-1], values[1:]):
        gains.append(max(b - a, 0.0))
        losses.append(max(a - b, 0.0))
    ag = sum(gains[:period]) / period
    al = sum(losses[:period]) / period
    for i in range(period, len(gains)):
        ag = (ag * (period - 1) + gains[i]) / period
        al = (al * (period - 1) + losses[i]) / period
    if al == 0:
        return 100.0
    return 100 - 100 / (1 + ag / al)


def clip(x, lo=-1.0, hi=1.0):
    return max(lo, min(hi, x))


def tanh_score(x):
    return math.tanh(x)


def norm_cdf(x):
    return 0.5 * (1 + math.erf(x / math.sqrt(2)))


def probabilities(mu, sigma):
    threshold = FLAT_K * sigma
    p_long = 1 - norm_cdf((threshold - mu) / sigma)
    p_short = norm_cdf((-threshold - mu) / sigma)
    p_flat = max(0.0, 1 - p_long - p_short)
    total = p_long + p_short + p_flat
    return {"long": p_long / total, "short": p_short / total, "flat": p_flat / total}, threshold


def candle_trend(candles, fast=9, slow=21):
    closes = [x["c"] for x in candles]
    if len(closes) < slow + 3:
        return 0.0
    price = closes[-1]
    f, s = ema(closes, fast)[-1], ema(closes, slow)[-1]
    vol = max((sum(abs(math.log(closes[i] / closes[i-1])) for i in range(len(closes)-20, len(closes))) / 20), 0.0001)
    return math.tanh((f - s) / price / (vol * 3))


def volume_profile(candles, bins=32):
    """Approximate volume profile by allocating each candle's volume to its typical price."""
    if len(candles) < 10:
        return None
    lo = min(x["l"] for x in candles)
    hi = max(x["h"] for x in candles)
    if hi <= lo:
        return None
    step = (hi - lo) / bins
    hist = [0.0] * bins
    for x in candles:
        typical = (x["h"] + x["l"] + x["c"]) / 3
        idx = min(bins - 1, max(0, int((typical - lo) / step)))
        hist[idx] += x["v"]
    poc_i = max(range(bins), key=lambda i: hist[i])
    target = sum(hist) * 0.70
    included, left, right = hist[poc_i], poc_i, poc_i
    while included < target and (left > 0 or right < bins - 1):
        lv = hist[left - 1] if left > 0 else -1
        rv = hist[right + 1] if right < bins - 1 else -1
        if rv > lv:
            right += 1
            included += hist[right]
        else:
            left -= 1
            included += hist[left]
    return {
        "poc": lo + (poc_i + 0.5) * step,
        "val": lo + left * step,
        "vah": lo + (right + 1) * step,
    }


def trade_flow(trades):
    """Aggressor buy/sell flow from aggTrades; m=True means buyer was maker => sell aggressor."""
    buy_quote = sell_quote = 0.0
    for t in trades or []:
        quote = float(t["p"]) * float(t["q"])
        if t.get("m", False):
            sell_quote += quote
        else:
            buy_quote += quote
    total = buy_quote + sell_quote
    delta = (buy_quote - sell_quote) / total if total else 0.0
    return delta, buy_quote, sell_quote


def liquidation_flow(rows):
    """Recent forced orders, if endpoint is available; not a liquidation heatmap."""
    buy_liq = sell_liq = 0.0
    for x in rows or []:
        order = x.get("o", x)
        qty = float(order.get("q", 0) or 0)
        price = float(order.get("ap", 0) or order.get("p", 0) or 0)
        value = qty * price
        # BUY order closes short; SELL order closes long.
        if order.get("S") == "BUY":
            buy_liq += value
        elif order.get("S") == "SELL":
            sell_liq += value
    total = buy_liq + sell_liq
    return (buy_liq - sell_liq) / total if total else 0.0, buy_liq, sell_liq


def orderbook_imbalance(depth):
    bids = depth.get("bids", [])
    asks = depth.get("asks", [])
    if not bids or not asks:
        raise BadData("пустой стакан")
    bid0, ask0 = float(bids[0][0]), float(asks[0][0])
    mid = (bid0 + ask0) / 2
    spread_pct = (ask0 - bid0) / mid * 100
    # Notional weighted by price*quantity, first 20 levels.
    bv = sum(float(p) * float(q) for p, q in bids[:20])
    av = sum(float(p) * float(q) for p, q in asks[:20])
    imbalance = (bv - av) / (bv + av) if bv + av else 0.0
    return math.tanh(imbalance * 2), spread_pct


def advanced_oi(d, price, prior_price):
    """OI/price context; OI history is 5m snapshots and can be unavailable."""
    try:
        hist = d.get("oi_hist") or []
        oi_values = [float(x["sumOpenInterest"]) for x in hist]
        if len(oi_values) >= 2:
            oi_change = oi_values[-1] / oi_values[0] - 1
        else:
            oi_change = 0.0
        price_change = price / prior_price - 1 if prior_price else 0.0
        # Interpret price and OI jointly, without claiming participant intent with certainty.
        joint = math.tanh(oi_change * 80) * math.tanh(price_change * 80)
        if price_change > 0 and oi_change > 0:
            label = "цена↑ OI↑: новые позиции поддерживают рост"
        elif price_change < 0 and oi_change > 0:
            label = "цена↓ OI↑: новые позиции на падении"
        elif price_change > 0 and oi_change < 0:
            label = "цена↑ OI↓: возможно закрытие шортов"
        elif price_change < 0 and oi_change < 0:
            label = "цена↓ OI↓: возможно закрытие лонгов"
        else:
            label = "OI без выраженного подтверждения"
        return joint, label, oi_change
    except Exception:
        return 0.0, "OI недоступен", 0.0


def compute(snapshot, now_ms, horizon_min):
    frames = {
        name: parse_klines(snapshot[name], now_ms)
        for name in ("k1", "k5", "k15", "k1h", "k4h")
    }
    min_need = {"k1": 30, "k5": 30, "k15": 30, "k1h": 25, "k4h": 15}
    for name, needed in min_need.items():
        if len(frames[name]) < needed:
            raise BadData(f"мало закрытых свечей {name}")
    m1 = frames["k1"]
    if now_ms - m1[-1]["t"] > 180_000:
        raise BadData("устаревшие минутные данные")

    price = m1[-1]["c"]
    prior_price = frames["k5"][-2]["c"]
    imbalance, spread = orderbook_imbalance(snapshot["depth"])
    if spread > MAX_SPREAD_PCT:
        raise BadData(f"спред {spread:.3f}% выше лимита")

    # Return volatility in the requested horizon, scaled from 1m returns.
    returns = [
        math.log(m1[i]["c"] / m1[i - 1]["c"])
        for i in range(max(1, len(m1) - 60), len(m1))
        if m1[i]["c"] > 0 and m1[i - 1]["c"] > 0
    ]
    mean_r = sum(returns) / max(1, len(returns))
    sigma_1m = max(
        math.sqrt(sum((x - mean_r) ** 2 for x in returns) / max(1, len(returns) - 1)),
        0.00015,
    )
    sigma = sigma_1m * math.sqrt(horizon_min)

    # Multi-timeframe trend: higher frames receive more context weight.
    mtf = (
        0.10 * candle_trend(frames["k1"], 8, 21)
        + 0.20 * candle_trend(frames["k5"], 9, 21)
        + 0.25 * candle_trend(frames["k15"], 9, 26)
        + 0.25 * candle_trend(frames["k1h"], 9, 26)
        + 0.20 * candle_trend(frames["k4h"], 9, 26)
    )

    cvd, buy_quote, sell_quote = trade_flow(snapshot["trades"])
    flow_score = math.tanh(cvd * 2.5)

    oi_score, oi_label, oi_change = advanced_oi(snapshot, price, prior_price)

    # Funding and crowding are contrarian inputs, deliberately low weight.
    deriv_score = 0.0
    try:
        funding = float(snapshot["prem"]["lastFundingRate"])
        deriv_score += -0.6 * math.tanh(funding / 0.0005)
    except Exception:
        funding = 0.0
    try:
        ratio = float(snapshot["ls"][-1]["longShortRatio"])
        deriv_score += -0.4 * math.tanh((ratio - 1.0) * 1.5)
    except Exception:
        ratio = 1.0
    deriv_score = clip(deriv_score)

    ob_score = imbalance
    liq_score, liq_buy, liq_sell = liquidation_flow(snapshot.get("liqs"))

    # Volume profile from recent 15m candles. Price relative to POC/VA.
    vp = volume_profile(frames["k15"][-48:])
    vp_score = 0.0
    vp_label = "Volume Profile недоступен"
    if vp:
        if price > vp["vah"]:
            vp_score, vp_label = 0.35, "цена выше VAH"
        elif price < vp["val"]:
            vp_score, vp_label = -0.35, "цена ниже VAL"
        elif price >= vp["poc"]:
            vp_score, vp_label = 0.12, "цена выше POC"
        else:
            vp_score, vp_label = -0.12, "цена ниже POC"

    # Recent candle momentum and RSI mean-reversion guard.
    closes = [x["c"] for x in frames["k15"]]
    mom = math.tanh((ema(closes, 9)[-1] - ema(closes, 21)[-1]) / price / max(sigma, 0.0005) * 2)
    r = rsi(closes[-60:])
    rsi_guard = -clip((r - 75) / 20) if r > 75 else clip((25 - r) / 20) if r < 25 else 0.0

    parts = {
        "MTF": 0.30 * mtf,
        "CVD": 0.20 * flow_score,
        "OI+цена": 0.15 * oi_score,
        "Order Flow/стакан": 0.12 * (0.65 * flow_score + 0.35 * ob_score),
        "Volume Profile": 0.08 * vp_score,
        "Funding/LS": 0.07 * deriv_score,
        "импульс/RSI": 0.08 * (0.7 * mom + 0.3 * rsi_guard),
    }
    score = clip(sum(parts.values()))
    mu = score * MU_SCALE * sigma
    probs, threshold = probabilities(mu, sigma)

    liq_label = (
        f"ликвидации: закрытие шортов ${liq_buy:,.0f}, "
        f"закрытие лонгов ${liq_sell:,.0f}"
        if liq_buy + liq_sell > 0 else "ликвидации: нет данных за выбранный период"
    )
    reasons = [
        f"CVD {cvd:+.2f} (покупки ${buy_quote:,.0f} / продажи ${sell_quote:,.0f})",
        oi_label,
        f"стакан {imbalance:+.2f}, спред {spread:.3f}%",
        vp_label,
        liq_label,
        f"RSI15 {r:.1f}",
    ]
    return {
        "price": price, "p": probs, "thr": threshold, "sigma": sigma,
        "score": score, "reasons": reasons, "parts": parts,
        "entry_ts": m1[-1]["t"] // 1000 + 60,
        "vp": vp, "oi_change": oi_change,
    }


