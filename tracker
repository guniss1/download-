def save_config(cfg):
    CONFIG_PATH.write_text(
        json.dumps(cfg, ensure_ascii=False, indent=2),
        encoding="utf-8",
    )


def get_token(cfg):
    token = os.environ.get("TG_BOT_TOKEN") or cfg.get("token")

    if not token:
        token = input(
            "Вставьте токен бота от @BotFather: "
        ).strip()

        if not token:
            raise RuntimeError("Не указан TG_BOT_TOKEN.")

        cfg["token"] = token
        save_config(cfg)

    return token


def exchange_params(cfg, name):
    """
    Параметры CCXT.
    Ключи добавляются только если заданы пользователем.
    Рекомендуется создавать ключи без торговых прав и права вывода.
    """

    params = {
        "enableRateLimit": True,
        "options": {
            "defaultType": "spot",
        },
    }

    stored = (cfg.get("keys") or {}).get(name, {})
    env = name.upper()

    key = (
        os.environ.get(f"{env}_API_KEY")
        or stored.get("apiKey")
    )

    secret = (
        os.environ.get(f"{env}_API_SECRET")
        or stored.get("secret")
    )

