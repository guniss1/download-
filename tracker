def normalize(text):
    t = text.lower().replace("ё", "е")

    t = re.sub(
        r"[^\w\s]",
        " ",
        t,
    )

    return " ".join(t.split())


def get_chat(context, update):
    cfg = context.application.bot_data["cfg"]

    return cfg.setdefault(
        "chats",
        {},
    ).get(
        str(update.effective_chat.id)
    )


async def on_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg = update.effective_message

    if not msg or not msg.text:
        return

    t = normalize(msg.text)

    if "трекер" in t and "ты тут" in t:
        cfg = context.application.bot_data["cfg"]

        chat_id = str(
            update.effective_chat.id
        )

        chats = cfg.setdefault(
            "chats",
            {},
        )

        new = chat_id not in chats

        chats.setdefault(
            chat_id,
            {
                "threshold": DEFAULT_THRESHOLD,
                "disabled": [],
                "min_trade_usdt": MIN_TRADE_USDT,
            },
        )

        save_config(cfg)

        c = chats[chat_id]

        await msg.reply_text(
            (
                "Да, тут! Подключился к этой группе. "
                if new
                else "Да, тут! "
            )
            + f"Присылаю разницу цен от {c['threshold']}% между биржами, "
            + f"если по стаканам можно провернуть от "
            + f"${c.get('min_trade_usdt', MIN_TRADE_USDT):g}.\n"
            + "Порог: /search 0.5%\n"
            + "Минимальный объём: /minsize 100\n"
            + "Биржи: /disable binance bybit, /enable binance bybit\n"
            + "Настройки: /status"
        )


async def search_cmd(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    msg = update.effective_message

    cfg = context.application.bot_data["cfg"]
    chat = get_chat(context, update)

    if chat is None:
        await msg.reply_text(
            "Сначала напишите в чате: «трекер, ты тут?»"
        )
        return

    if not context.args:
        await msg.reply_text(
            "Формат: /search 0.5%"
        )
        return

    try:
        value = float(
            context.args[0]
            .replace("%", "")
            .replace(",", ".")
        )

    except ValueError:
        await msg.reply_text(
            "Не понял число. Пример: /search 0.5%"
        )
        return

    if not (0.05 <= value <= MAX_SPREAD_PCT):
        await msg.reply_text(
            f"Порог должен быть от 0.05% до {MAX_SPREAD_PCT}%."
        )
        return

    chat["threshold"] = value

    save_config(cfg)

    await msg.reply_text(
        f"Ищу разницу цен от {value}% между биржами."
    )


