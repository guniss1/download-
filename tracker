async def currency_loop(app: Application):
    """
    Обновляет статусы ввода/вывода.

    Если запрос не удался, старые данные сбрасываются,
    чтобы бот не использовал устаревший статус как актуальный.
    """

    exchanges = app.bot_data["exchanges"]
    store = app.bot_data["currencies"]

    while True:
        try:
            wanted = set()

            for c in app.bot_data["cfg"].get(
                "chats",
                {},
            ).values():

                wanted |= (
                    set(EXCHANGES)
                    - set(c.get("disabled", []))
                )

            now = time.time()

            due = [
                e
                for e in exchanges
                if (
                    e.id in wanted
                    and now - store.get(e.id, {}).get("time", 0)
                    > CURRENCY_TTL
                )
            ]

            if due:
                results = await asyncio.gather(
                    *[
                        load_currencies(e)
                        for e in due
                    ]
                )

                for ex, (data, err) in zip(due, results):
                    if data:
                        store[ex.id] = {
                            "time": time.time(),
                            "cur": data,
                            "error": None,
                        }

                        log.info(
                            "%s: статусы ввода/вывода получены для %d монет",
                            ex.id,
                            len(data),
                        )

                        _cur_warned.discard(ex.id)

                    else:
                        # Старые данные не сохраняем.
                        # Повторная попытка будет через CURRENCY_RETRY.
                        store[ex.id] = {
                            "time": (
                                time.time()
                                - CURRENCY_TTL
                                + CURRENCY_RETRY
                            ),
                            "cur": None,
                            "error": err,
                        }

                        if ex.id not in _cur_warned:
                            _cur_warned.add(ex.id)

                            log.info(
                                "%s: статусы недоступны "
                                "(часто нужны API-ключи только на чтение). %s",
                                ex.id,
                                err or "",
                            )

        except asyncio.CancelledError:
            raise

        except Exception:
            log.exception(
                "Ошибка в обновлении статусов монет"
            )

        await asyncio.sleep(30)


