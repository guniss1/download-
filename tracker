async def load_currencies(ex):
    """
    Сначала использует специальный загрузчик, если он есть.
    Затем пробует стандартный CCXT.
    """

    loaders = []

    if ex.id in CURRENCY_OVERRIDE:
        loaders.append(
            lambda: CURRENCY_OVERRIDE[ex.id](ex)
        )

    loaders.append(
        lambda: ex.fetch_currencies()
    )

    errors = []

    for load in loaders:
        try:
            data = await asyncio.wait_for(
                load(),
                60,
            )

            if data:
                return data, None

        except Exception as e:
            errors.append(str(e)[:150])

    return None, "; ".join(errors)


