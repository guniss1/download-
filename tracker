def parse_names(args):
    return [
        part.lower()
        for raw in args
        for part in raw.replace(",", " ").split()
    ]


async def toggle_cmd(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
    enable: bool,
):
    msg = update.effective_message

    cfg = context.application.bot_data["cfg"]
    chat = get_chat(context, update)

    cmd = "/enable" if enable else "/disable"

    if chat is None:
        await msg.reply_text(
            "Сначала напишите в чате: «трекер, ты тут?»"
        )
        return

    names = parse_names(context.args)

    if not names:
        await msg.reply_text(
            f"Формат: {cmd} binance bybit\n"
            + "Биржи: "
            + ", ".join(EXCHANGES)
            + (
                "\nВключить все: /enable all"
                if enable
                else ""
            )
        )
        return

    disabled = set(
        chat.get("disabled", [])
    )

    unknown = []

    if enable and names == ["all"]:
        disabled.clear()

    else:
        valid = [
            n
            for n in names
            if n in EXCHANGES
        ]

        unknown = [
            n
            for n in names
            if n not in EXCHANGES
        ]

        if enable:
            disabled -= set(valid)
        else:
            disabled |= set(valid)

    chat["disabled"] = [
        e
        for e in EXCHANGES
        if e in disabled
    ]

    save_config(cfg)

    enabled = [
        e
        for e in EXCHANGES
        if e not in disabled
    ]

    lines = []

    if unknown:
        lines.append(
            "Не знаю такие биржи: "
            + ", ".join(unknown)
        )

    lines.append(
        "Включены: "
        + (", ".join(enabled) or "нет")
    )

    if disabled:
        lines.append(
            "Выключены: "
            + ", ".join(
                e
                for e in EXCHANGES
                if e in disabled
            )
        )

    if len(enabled) < 2:
        lines.append(
            "⚠️ Нужно минимум 2 включённые биржи."
        )

    await msg.reply_text(
        "\n".join(lines)
    )


async def enable_cmd(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    await toggle_cmd(
        update,
        context,
        True,
    )


async def disable_cmd(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    await toggle_cmd(
        update,
        context,
        False,
    )


async def status_cmd(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    msg = update.effective_message

    chat = get_chat(context, update)

    if chat is None:
        await msg.reply_text(
            "Уведомления выключены. Включить: «трекер, ты тут?»"
        )
        return

    bd = context.application.bot_data

    off = set(
        chat.get("disabled", [])
    )

    enabled = [
        e
        for e in EXCHANGES
        if e not in off
    ]

    lines = [
        (
            f"Уведомления включены, "
            f"порог {chat.get('threshold', DEFAULT_THRESHOLD)}%, "
            f"мин. объём "
            f"${chat.get('min_trade_usdt', MIN_TRADE_USDT):g}"
        ),
        "Включены: " + (", ".join(enabled) or "нет"),
    ]

    if off:
        lines.append(
            "Выключены: "
            + ", ".join(
                e
                for e in EXCHANGES
                if e in off
            )
        )

    unavailable = [
        e
        for e in enabled
        if e in bd.get("down", set())
    ]

    if unavailable:
        lines.append(
            "Не отвечают сейчас: "
            + ", ".join(unavailable)
        )

    missing = bd.get("missing", [])

    if missing:
        lines.append(
            "Нет в установленной ccxt: "
            + ", ".join(missing)
            + " (pip install -U ccxt)"
        )

    store = bd.get("currencies", {})

    known = []
    unknown = []

    for e in enabled:
        entry = store.get(e) or {}

        if (
            entry.get("cur")
            and time.time() - entry.get("time", 0) <= CURRENCY_TTL
        ):
            known.append(e)
        else:
            unknown.append(e)

    lines.append(
        "Данные о валютах получены: "
        + (", ".join(known) or "ни для одной биржи")
    )

    if unknown:
        lines.append(
            "Статус перевода может быть ⚪/🟡: "
            + ", ".join(unknown)
        )

    lines.append(
        "🟢 выдаётся только при подтверждённой сети "
        "и совпадении контрактов."
    )

    await msg.reply_text(
        "\n".join(lines)
    )


async def stop_cmd(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):
    cfg = context.application.bot_data["cfg"]

    chats = cfg.setdefault(
        "chats",
        {},
    )

    if chats.pop(
        str(update.effective_chat.id),
        None,
    ) is not None:

        save_config(cfg)

        await update.effective_message.reply_text(
            "Уведомления в этом чате выключены. "
            "Включить: «трекер, ты тут?»"
        )

    else:
        await update.effective_message.reply_text(
            "Уведомления и так выключены."
        )


