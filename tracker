def _bool(x):
    if isinstance(x, str):
        return x.strip().lower() == "true"
    return bool(x)


def parse_network_list(items):
    """Формат WEEX/Binance: [{coin, networkList: [{network, depositEnable, withdrawEnable}]}]
    -> формат, похожий на ccxt currencies."""
    out = {}
    for c in items or []:
        if not isinstance(c, dict):
            continue
        code = str(c.get("coin", "")).upper()
        if not code:
            continue
        nets = {}
        for n in c.get("networkList") or []:
            name = n.get("network") or n.get("name")
            if name:
                nets[name] = {
                    "withdraw": _bool(n.get("withdrawEnable")),
                    "deposit": _bool(n.get("depositEnable")),
                }
        out[code] = {"withdraw": None, "deposit": None, "networks": nets}
    return out


def parse_bitget_coins(items):
    """Формат Bitget: [{coin, chains: [{chain, withdrawable, rechargeable}]}] (булевы - строками)."""
    out = {}
    for c in items or []:
        if not isinstance(c, dict):
            continue
        code = str(c.get("coin", "")).upper()
        if not code:
            continue
        nets = {}
        for ch in c.get("chains") or []:
            name = ch.get("chain")
            if name:
                nets[name] = {
                    "withdraw": _bool(ch.get("withdrawable")),
                    "deposit": _bool(ch.get("rechargeable")),
                }
        out[code] = {"withdraw": None, "deposit": None, "networks": nets}
    return out


