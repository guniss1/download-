def depth_orders(asks, bids, thr_pct):
    """
    Сопоставляет уровни покупки и продажи.
    Считает объём, который можно исполнить при заданной разнице.
    """

    orders = []

    sell_hi = 0.0
    sell_lo = float("inf")

    cost = 0.0
    revenue = 0.0
    qty_total = 0.0

    i = 0
    j = 0

    ask_left = None
    bid_left = None

    while i < len(asks) and j < len(bids):
        pa = float(asks[i][0])
        qa = float(asks[i][1])

        pb = float(bids[j][0])
        qb = float(bids[j][1])

        if pa <= 0 or qa <= 0 or pb <= 0 or qb <= 0:
            break

        if (pb / pa - 1) * 100 < thr_pct:
            break

        if ask_left is None:
            ask_left = qa

        if bid_left is None:
            bid_left = qb

        take = min(ask_left, bid_left)

        if not orders or orders[-1]["i"] != i:
            orders.append(
                {
                    "i": i,
                    "price": pa,
                    "qty": 0.0,
                    "rev": 0.0,
                }
            )

        orders[-1]["qty"] += take
        orders[-1]["rev"] += take * pb

        cost += take * pa
        revenue += take * pb
        qty_total += take

        sell_hi = max(sell_hi, pb)
        sell_lo = min(sell_lo, pb)

        ask_left -= take
        bid_left -= take

        if ask_left <= 1e-12:
            i += 1
            ask_left = None

        if bid_left <= 1e-12:
            j += 1
            bid_left = None

    orders = [
        o for o in orders
        if o["qty"] > 0
    ]

    if not orders or cost <= 0:
        return None

    for o in orders:
        o["margin"] = (
            o["rev"] / (o["qty"] * o["price"]) - 1
        ) * 100

    return {
        "orders": orders,
        "usdt": cost,
        "qty": qty_total,
        "revenue": revenue,
        "buy_lo": orders[0]["price"],
        "buy_hi": orders[-1]["price"],
        "sell_hi": sell_hi,
        "sell_lo": sell_lo,
    }


